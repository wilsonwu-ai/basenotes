<section class="jeff-newsletter" id="newsletter" aria-labelledby="JeffNewsletterHeading-{{ section.id }}">
  <div class="container jeff-newsletter__inner">
    <div>
      <p class="jeff-newsletter__eyebrow">Always something new</p>
      <h2 id="JeffNewsletterHeading-{{ section.id }}">New scents keep landing.</h2>
      <p>Get first notice when the next designer and niche fragrances drop.</p>
    </div>
    {%- form 'customer', class: 'jeff-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="visually-hidden" for="JeffNewsletterEmail-{{ section.id }}">Email address</label>
      <input id="JeffNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="Enter your email" required>
      <button type="submit">Tell me first</button>
      {%- if form.posted_successfully? -%}<p class="jeff-newsletter__message">You're on the list. Watch your inbox.</p>{%- endif -%}
      {%- if form.errors -%}<p class="jeff-newsletter__message">Please enter a valid email address.</p>{%- endif -%}
    {%- endform -%}
  </div>
</section>

<style>
  .jeff-newsletter { --jn-green:#22392B; --jn-cream:#F4EFE3; --jn-gold:#AC9159; --jn-ink:#242320; padding:6rem 0; background:var(--jn-cream); color:var(--jn-ink); }
  .jeff-newsletter__inner { display:flex; align-items:end; justify-content:space-between; gap:3rem; }
  .jeff-newsletter__eyebrow { margin:0 0 1.25rem; color:var(--jn-gold); font:600 .78rem/1.2 var(--font-body); letter-spacing:.2em; text-transform:uppercase; }
  .jeff-newsletter h2 { margin:0; font-size:clamp(2.6rem,5vw,4.2rem); }
  .jeff-newsletter p:not(.jeff-newsletter__eyebrow) { margin:.8rem 0 0; color:#68635b; }
  .jeff-newsletter__form { width:min(100%,480px); display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:end; }
  .jeff-newsletter__form input { min-width:0; height:52px; padding:.75rem 1rem; border:0; border-bottom:1px solid var(--jn-green); background:transparent; border-radius:0; color:var(--jn-ink); font:400 .9rem/1 var(--font-body); }
  .jeff-newsletter__form input:focus { outline:2px solid var(--jn-gold); outline-offset:2px; }
  .jeff-newsletter__form button { height:52px; padding:.75rem 1.5rem; border:1px solid var(--jn-green); background:var(--jn-green); color:#fff; font:600 .72rem/1 var(--font-body); letter-spacing:.13em; text-transform:uppercase; cursor:pointer; }
  .jeff-newsletter__message { grid-column:1/-1; font-size:.8rem!important; }
  @media (max-width:749px) { .jeff-newsletter { padding:4rem 0; } .jeff-newsletter__inner { align-items:flex-start; flex-direction:column; } .jeff-newsletter__form { grid-template-columns:1fr; } .jeff-newsletter__form button { margin-top:.75rem; } }
</style>

{% schema %}
{"name":"Jeff newsletter","settings":[],"presets":[{"name":"Jeff newsletter"}]}
{% endschema %}
