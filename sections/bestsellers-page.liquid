{%- liquid
  assign bestseller_collection = section.settings.collection
  if bestseller_collection == blank
    assign bestseller_collection = collections['bestsellers']
  endif
  assign products_to_show = section.settings.products_to_show | default: 12
-%}

<section
  class="bestsellers-page section section--cream"
  aria-labelledby="BestsellersTitle-{{ section.id }}"
>
  <div class="container">
    <header class="bestsellers-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="section__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="bestsellers-page__title" id="BestsellersTitle-{{ section.id }}">
        {{- section.settings.heading -}}
      </h1>
      {%- if section.settings.description != blank -%}
        <p class="bestsellers-page__description">{{ section.settings.description }}</p>
      {%- endif -%}
    </header>

    {%- if bestseller_collection != blank and bestseller_collection.products_count > 0 -%}
      <div class="bestsellers-page__grid">
        {%- for product in bestseller_collection.products limit: products_to_show -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>

      {%- if bestseller_collection.products_count > products_to_show -%}
        <div class="bestsellers-page__action">
          <a class="btn btn--outline" href="{{ bestseller_collection.url }}">
            {{- 'sections.bestsellers.view_all' | t -}}
          </a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="bestsellers-page__empty">
        <h2 class="bestsellers-page__empty-title">{{ 'sections.bestsellers.empty_heading' | t }}</h2>
        <p class="bestsellers-page__empty-copy">{{ 'sections.bestsellers.empty_body' | t }}</p>
        <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
          {{- 'sections.bestsellers.browse_all' | t -}}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .bestsellers-page__header {
    max-width: 42.5rem;
    margin: 0 auto var(--spacing-2xl);
    text-align: center;
  }

  .bestsellers-page__title {
    margin: var(--spacing-sm) 0 var(--spacing-md);
    color: var(--color-primary);
  }

  .bestsellers-page__description {
    max-width: 36.25rem;
    margin: 0 auto;
    color: var(--color-text-light);
  }

  .bestsellers-page__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--spacing-lg);
  }

  .bestsellers-page__action {
    margin-top: var(--spacing-2xl);
    text-align: center;
  }

  .bestsellers-page__empty {
    max-width: 35rem;
    margin: 0 auto;
    padding: var(--spacing-2xl);
    border: 1px solid var(--color-border);
    text-align: center;
  }

  .bestsellers-page__empty-title {
    margin: 0 0 var(--spacing-sm);
    color: var(--color-primary);
  }

  .bestsellers-page__empty-copy {
    margin: 0 0 var(--spacing-lg);
    color: var(--color-text-light);
  }

  @media (max-width: 62rem) {
    .bestsellers-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 48rem) {
    .bestsellers-page__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-md);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Retailer bestsellers",
  "tag": "section",
  "class": "bestsellers-page-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Retailer picks"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Retailer Bestsellers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "The fragrances retailers and their customers are reaching for most."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Bestseller collection",
      "info": "Choose an automated or manually curated Shopify collection. If blank, the bestsellers collection handle is used."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Retailer bestsellers"
    }
  ]
}
{% endschema %}
