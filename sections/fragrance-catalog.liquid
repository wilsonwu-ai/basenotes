{{ 'scent-storefront.css' | asset_url | stylesheet_tag }}
{%- paginate collection.products by 48 -%}
<scent-catalog class="fragrance-catalog" data-source="Fragrance collection">
  <nav class="fragrance-catalog__tabs" aria-label="Fragrance preference"><button class="is-active" type="button" data-gender-filter="all" aria-pressed="true">All</button><button type="button" data-gender-filter="him" aria-pressed="false">For him</button><button type="button" data-gender-filter="her" aria-pressed="false">For her</button><button type="button" data-gender-filter="unisex" aria-pressed="false">Unisex</button></nav>
  <header class="fragrance-catalog__hero"><p class="scent-eyebrow">Start with $20</p><h1>{% if collection.handle == 'fragrances' or collection.handle == 'all' %}Find scents that work for you.{% else %}{{ collection.title }}{% endif %}</h1><p class="fragrance-catalog__intro">Real designer and niche fragrance. Your next favorite, in a 5ml vial.</p><a href="{{ routes.root_url }}#how-it-works">New to decants? Here’s how this works</a><p class="fragrance-catalog__pricing">$20 for your first fragrance <span aria-hidden="true">·</span> $18 for each one after</p><p class="fragrance-catalog__trust">Authentic fragrance. One-time purchase. No subscription required.</p></header>
  <div class="fragrance-catalog__body"><div class="fragrance-catalog__toolbar"><label for="ScentSearch-{{ section.id }}">Find a fragrance<input id="ScentSearch-{{ section.id }}" type="search" placeholder="Search scent or brand" data-scent-search autocomplete="off"></label><p data-scent-count aria-live="polite">{{ collection.products_count }} fragrances</p></div>
    <div class="scent-grid">{%- for product in collection.products -%}{% render 'studio-fragrance-card', product: product, section_id: section.id %}{%- endfor -%}</div>
    <div class="fragrance-catalog__empty" data-scent-empty hidden><h2>No scents in this selection.</h2><p>Try a different name or explore the full collection.</p><button type="button" class="scent-button" data-clear-filters>View all fragrances</button></div>
    {% if paginate.pages > 1 %}<nav class="scent-pagination" aria-label="Fragrance pages">{{ paginate | default_pagination }}</nav>{% endif %}
    <p class="scent-feedback" data-scent-status role="status" aria-live="polite"></p>
    <p class="fragrance-catalog__format">Every vial shown is a 5ml Base Note atomizer. Original bottles are pictured for fragrance identification. Wear any scent you enjoy; preference filters use available catalog labels and include unisex fragrances.</p>
    {% assign collection_description_text = collection.description | strip_html | strip %}{% if collection_description_text != blank and collection_description_text != 'List Showing the Fragrances Offered' %}<div class="fragrance-catalog__description">{{ collection.description }}</div>{% endif %}
  </div>
</scent-catalog>
{%- endpaginate -%}
<script src="{{ 'scent-storefront.js' | asset_url }}" defer></script>
{% schema %}
{"name":"Fragrance catalog","settings":[],"presets":[{"name":"Fragrance catalog"}]}
{% endschema %}
