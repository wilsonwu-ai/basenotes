{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign vial_variant = nil
  assign bottle_variant = nil
  for candidate in product.variants
    assign compact_size = candidate.title | downcase | remove: ' '
    if compact_size == '5ml'
      assign vial_variant = candidate
    elsif compact_size contains 'ml' or compact_size contains 'oz' or compact_size contains 'fullbottle'
      assign bottle_variant = candidate
    endif
  endfor
  assign current_variant = product.selected_variant | default: vial_variant | default: current_variant
  assign current_allocation = current_variant.selling_plan_allocations.first
  assign display_title = product.title | remove_first: product.vendor | remove: 'EDP' | remove: 'Eau de Parfum' | strip
  assign primary_image = product.featured_image
  assign top_notes = product.metafields.custom.top_notes.value
  assign heart_notes = product.metafields.custom.heart_notes.value
  assign base_notes = product.metafields.custom.base_notes.value
  assign bn_logged_in = false
  if customer
    assign bn_logged_in = true
  endif

  assign notes_source = product.description | replace: 'Top Note:', 'Top Notes:' | replace: 'Heart Note:', 'Heart Notes:' | replace: 'Base Note:', 'Base Notes:'
  assign description_html = notes_source
  if notes_source contains 'Top Notes:'
    assign story_before = notes_source | split: 'Top Notes:' | first
    assign story_parts = story_before | split: '</p>'
    if story_parts.size > 1
      assign keep_count = story_parts.size | minus: 1
      assign description_html = ''
      for chunk in story_parts limit: keep_count
        assign description_html = description_html | append: chunk | append: '</p>'
      endfor
    else
      assign description_html = story_before
    endif

    if top_notes == blank
      assign top_notes = notes_source | split: 'Top Notes:' | last | strip_html | split: 'Heart Notes:' | first | split: 'Base Notes:' | first | strip
    endif
    if heart_notes == blank and notes_source contains 'Heart Notes:'
      assign heart_notes = notes_source | split: 'Heart Notes:' | last | strip_html | split: 'Base Notes:' | first | strip
    endif
    if base_notes == blank and notes_source contains 'Base Notes:'
      assign base_notes = notes_source | split: 'Base Notes:' | last | strip_html | strip
    endif
  endif

  capture concentration
    render 'product-concentration', product: product
  endcapture

  assign is_internal_addon_product = false
  if product.handle == 'extra-5ml-vial-add-on'
    assign is_internal_addon_product = true
  endif

  assign bottle_retail = bottle_variant.compare_at_price | default: product.metafields.custom.retail_price | default: 0
  assign bottle_price = bottle_variant.price
  assign bottle_percent = 0
  if bottle_retail > bottle_price and bottle_retail > 0
    assign bottle_savings = bottle_retail | minus: bottle_price
    assign bottle_percent = bottle_savings | times: 100 | divided_by: bottle_retail
  endif
-%}

{%- if is_internal_addon_product -%}
  <!-- INTERNAL_ADDON_GUARD_COPY_START -->
  <section class="artifact-product artifact-product--guard">
    <div class="artifact-product__guard" data-internal-addon-route-guard>
      <p class="artifact-product__eyebrow">Additional fragrance</p>
      <h1>Choose the scent that goes in your vial.</h1>
      <p>This item is configured when you add a fragrance to your order.</p>
      <button type="button" disabled>Choose a fragrance first</button>
      <a href="/collections/fragrances">Shop fragrances</a>
    </div>
  </section>
  <!-- INTERNAL_ADDON_GUARD_COPY_END -->
{%- endif -%}

{%- unless is_internal_addon_product -%}
  <!-- INTERNAL_ADDON_PURCHASE_UI_START -->
  <artifact-product class="artifact-product" data-product-handle="{{ product.handle }}" data-product-title="{{ product.title | escape }}">
    <div class="artifact-product__shell">
      <a class="artifact-product__back" href="/collections/fragrances">← All fragrances</a>
      <div class="artifact-product__top">
        <div class="artifact-product__media">
          <div class="artifact-product__visual{% unless current_variant.id == vial_variant.id %} artifact-product__visual--single{% endunless %}" data-product-comparison>
            <div class="artifact-product__comparison">
              <figure class="artifact-product__reference artifact-product__reference--original">
                <div class="artifact-product__photo-object">
                  {%- if primary_image -%}
                    {%- assign image_alt = primary_image.alt | default: product.title -%}
                    {{ primary_image | image_url: width: 1000 | image_tag: class: 'artifact-product__image', widths: '400, 600, 800, 1000', sizes: '(min-width: 850px) 320px, 65vw', loading: 'eager', fetchpriority: 'high', alt: image_alt, data-product-main-image: '' }}
                  {%- else -%}
                    {% render 'vial-illustration', product: product %}
                  {%- endif -%}
                </div>
                <figcaption class="artifact-product__reference-label">Original fragrance</figcaption>
              </figure>
            </div>
          </div>
          {%- if product.images.size > 1 -%}
            <div class="artifact-product__thumbnails" aria-label="Product photographs">
              {%- for product_image in product.images limit: 5 -%}
                <button type="button" class="artifact-product__thumbnail" data-product-image="{{ product_image | image_url: width: 1000 }}" data-alt="{{ product_image.alt | default: product.title | escape }}" aria-label="View {{ product.title | escape }} photograph {{ forloop.index }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ product_image | image_url: width: 120 | image_tag: loading: 'lazy', width: 56, height: 56, alt: '' }}</button>
              {%- endfor -%}
            </div>
          {%- endif -%}
          <p class="artifact-product__caption">5ml orders arrive in the labeled Base Note spray atomizer. Original bottle shown for fragrance identification.</p>
        </div>

        <div class="artifact-product__info">
          <p class="artifact-product__eyebrow">{{ product.vendor | escape }}</p>
          <h1>{{ display_title | default: product.title | escape }}</h1>
          <p class="artifact-product__meta">{{ concentration | strip }}{% if vial_variant %} <span aria-hidden="true">·</span> Decanted to 5ml{% endif %}</p>

          <div class="artifact-product__pills" aria-label="Fragrance character">
            {%- assign pills_shown = 0 -%}
            {%- for pill in product.tags -%}
              {%- assign pill_down = pill | downcase -%}
              {%- if pill contains ':' or pill_down == 'date night' or pill_down == 'everyday wear' or pill_down == 'signature' or pill_down == 'wedding/formal' or pill_down contains 'gender' -%}{%- continue -%}{%- endif -%}
              {%- if pill_down contains 'conc_' or pill_down contains 'origin_' or pill_down contains 'season_' or pill_down contains 'occasion_' -%}{%- continue -%}{%- endif -%}
              {%- assign pill_label = pill | remove_first: 'Family_' | remove_first: 'family_' -%}
              <span>{{ pill_label | escape }}</span>{%- assign pills_shown = pills_shown | plus: 1 -%}
              {%- if pills_shown == 5 -%}{%- break -%}{%- endif -%}
            {%- endfor -%}
          </div>

          {%- assign all_tags_down = product.tags | join: '|' | downcase -%}
          {%- assign season_acc = '' -%}
          {%- assign season_order = 'spring,summer,fall,winter' | split: ',' -%}
          {%- for sname in season_order -%}
            {%- assign needle_new = 'season_' | append: sname -%}
            {%- assign needle_old = 'season:' | append: sname -%}
            {%- assign hit = false -%}
            {%- if all_tags_down contains needle_new or all_tags_down contains needle_old -%}{%- assign hit = true -%}{%- endif -%}
            {%- if sname == 'fall' and all_tags_down contains 'autumn' -%}{%- assign hit = true -%}{%- endif -%}
            {%- if hit -%}{%- assign season_acc = season_acc | append: sname | append: ',' -%}{%- endif -%}
          {%- endfor -%}
          {%- assign season_list = season_acc | split: ',' -%}
          {%- if season_list.size > 0 and season_list.size < 4 -%}
            <p class="artifact-product__season">Best in{% for s in season_list %}{% if forloop.first %} {% elsif forloop.last %} and {% else %}, {% endif %}{{ s }}{% endfor %}.</p>
          {%- endif -%}

          {%- assign pdp_review_count = product.metafields.reviews.rating_count.value | default: product.metafields.judgeme.review_count | default: product.metafields.reviews.count.value | default: 0 -%}
          {%- if pdp_review_count > 0 -%}
            <a class="artifact-product__rating-line" href="#judgeme_product_reviews">
              {% render 'product-review-badge', product: product, surface: 'product' %}
              <span class="artifact-product__rating-jump">Read {{ pdp_review_count }} review{% unless pdp_review_count == 1 %}s{% endunless %}</span>
            </a>
          {%- endif -%}

          {%- form 'product', product, class: 'artifact-product__form', data-product-form: '', data-artifact-product-form: '' -%}
            <fieldset class="artifact-product__sizes">
              <legend class="visually-hidden">Choose a size</legend>
              {%- for variant in product.variants -%}
                <label class="artifact-product__size"><input type="radio" name="id" value="{{ variant.id }}" class="visually-hidden" data-artifact-size {% if variant.id == current_variant.id %}checked{% endif %}>{% if variant.title == 'Default Title' %}{{ product.title | escape }}{% else %}{{ variant.title | escape }}{% endif %}</label>
              {%- endfor -%}
            </fieldset>

            <p class="artifact-product__price" data-artifact-product-price>{{ current_variant.price | money_without_trailing_zeros }}</p>
            <p class="artifact-product__price-note" data-artifact-price-note>{% if current_variant.id == vial_variant.id and current_variant.price == 2000 %}{{ current_variant.price | money_without_trailing_zeros }} first vial · $18 each additional vial in your order.{% endif %}</p>

            <div class="artifact-product__quantity">
              <button type="button" data-artifact-qty="minus" aria-label="Decrease quantity" hidden>−</button>
              <label class="visually-hidden" for="ArtifactQuantity-{{ section.id }}">Quantity</label>
              <input id="ArtifactQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" max="99" inputmode="numeric" data-artifact-quantity>
              <button type="button" data-artifact-qty="plus" aria-label="Increase quantity" hidden>+</button>
            </div>

            {%- if vial_variant.selling_plan_allocations.size > 0 -%}
              <div class="artifact-product__rotation" id="monthly-rotation">
                <label for="ArtifactOrder-{{ section.id }}">How would you like to order?</label>
                <select id="ArtifactOrder-{{ section.id }}" data-artifact-rotation>
                  <option value="">One-time purchase</option>
                  <option value="subscription">Monthly Rotation subscription</option>
                  <option value="queue" data-queue-option hidden>Add to my Rotation queue</option>
                </select>
                <input type="hidden" name="selling_plan" value="" data-artifact-plan disabled>
              </div>
              <div class="artifact-product__rotation-note" data-artifact-rotation-note hidden>
                <p><strong>This is a recurring monthly subscription.</strong> First shipment <span data-plan-first>{{ current_allocation.price | money_without_trailing_zeros }}</span>, then <span data-plan-renewal>{{ current_allocation.price_adjustments.last.price | default: current_variant.price | money_without_trailing_zeros }}</span> every month until cancelled. Skip, swap, or cancel in your account.</p>
                <label class="artifact-product__consent"><input type="checkbox" data-artifact-consent disabled> <span>I agree to the recurring charges and <a href="{{ shop.subscription_policy.url | default: '/policies/subscription-policy' }}">subscription terms</a>.</span></label>
              </div>

              <div class="artifact-product__queue" data-artifact-queue data-logged-in="{{ bn_logged_in }}" data-product-title="{{ display_title | default: product.title | escape }}" data-product-vendor="{{ product.vendor | escape }}" hidden>
                <p class="artifact-product__queue-chip" data-queue-chip hidden>Monthly Rotation · next ship <span data-queue-next>Oct 4</span></p>
                <label for="ArtifactQueue-{{ section.id }}">Queue this scent for</label>
                <select id="ArtifactQueue-{{ section.id }}" name="properties[Queue month]" data-artifact-queue-month disabled>
                  <option value="2026-10">October 2026 (next shipment)</option>
                  <option value="2026-11" selected>November 2026</option>
                  <option value="2026-12">December 2026</option>
                  <option value="2027-01">January 2027</option>
                  <option value="2027-02">February 2027</option>
                </select>
                <p class="artifact-product__queue-hint">Replaces the fragrance for that month. That month still bills at $20. An extra vial in the same box is $18 from your account.</p>
                <p class="artifact-product__queue-ok" data-queue-ok hidden></p>
                <p class="artifact-product__queue-warn" data-queue-warn hidden>Log in with the account that holds your Monthly Rotation to queue a future month.</p>
              </div>
            {%- endif -%}

            <button id="addToCartButton" class="artifact-product__add" type="submit" data-artifact-submit {% unless current_variant.available %}disabled{% endunless %}>
              {% if current_variant.available %}Add to cart{% else %}Sold out{% endif %}
            </button>

            {%- unless bn_logged_in -%}
              <p class="artifact-product__subscriber-prompt">
                Already a subscriber? <a href="/account/login?return_to={{ product.url | url_encode }}">Log in</a> to add to your queue.
              </p>
            {%- endunless -%}
          {%- endform -%}

          <p class="artifact-product__size-note" data-artifact-size-note>{% if vial_variant %}5ml in a portable spray atomizer. Try it on your skin before committing to a bottle.{% else %}Original full bottle. Size and price shown are for the selected variant.{% endif %}</p>
          <p class="artifact-product__shipping"><a href="/pages/shipping">Shipping &amp; delivery details</a></p>

          {%- if bottle_variant != blank and bottle_variant.available -%}
            <aside class="artifact-product__bottle artifact-product__bottle--stocked">
              <p class="artifact-product__bottle-label">Full bottle — in stock</p>
              <p>{{ bottle_variant.title | escape }} original bottle. The same fragrance as this 5ml.</p>
              {%- if bottle_percent > 0 -%}
                <p class="artifact-product__bottle-price">
                  <s>{{ bottle_retail | money_without_trailing_zeros }}</s> {{ bottle_price | money_without_trailing_zeros }} · Save {{ bottle_percent }}%
                </p>
              {%- else -%}
                <p class="artifact-product__bottle-price">{{ bottle_price | money_without_trailing_zeros }}</p>
              {%- endif -%}
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ bottle_variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="artifact-product__add">Add the {{ bottle_variant.title | escape }} bottle to cart</button>
              </form>
            </aside>
          {%- else -%}
            <aside class="artifact-product__bottle">
              <p class="artifact-product__bottle-label">Full bottle</p>
              <p>We decant this from the original bottle. When we stock the full size, it will appear here.</p>
              <a class="artifact-product__bottle-notify" href="/pages/full-bottles?fragrance={{ product.title | url_encode }}#BottleEnquiry">Notify me when the full bottle is in</a>
            </aside>
          {%- endif -%}

          {% render 'product-journal-link', product: product %}
          <p class="artifact-product__status" data-artifact-product-status role="status" aria-live="polite"></p>
        </div>
      </div>

      <div class="artifact-product__story">
        <div class="artifact-product__description">{{ description_html }}</div>
        <div class="artifact-product__details">
          {%- if top_notes != blank or heart_notes != blank or base_notes != blank -%}
            <section><h2>Key notes</h2><div class="artifact-product__notes">
              {%- if top_notes != blank -%}<div><span>Top</span><p>{{ top_notes | escape }}</p></div>{%- endif -%}
              {%- if heart_notes != blank -%}<div><span>Heart</span><p>{{ heart_notes | escape }}</p></div>{%- endif -%}
              {%- if base_notes != blank -%}<div><span>Base</span><p>{{ base_notes | escape }}</p></div>{%- endif -%}
            </div></section>
          {%- endif -%}
          {%- capture occasions -%}
            {%- for tag in product.tags -%}
              {%- if tag contains 'Occasion_' -%}
                {%- assign occ = tag | remove: 'Occasion_' -%}
                {%- case occ -%}
                  {%- when 'DateNight' -%}<li>Date night</li>
                  {%- when 'Everyday' -%}<li>Everyday</li>
                  {%- when 'Office' -%}<li>Office</li>
                  {%- when 'Signature' -%}<li>Signature</li>
                  {%- when 'Evening' -%}<li>Evening</li>
                  {%- else -%}<li>{{ occ | escape }}</li>
                {%- endcase -%}
              {%- elsif tag contains 'event:' -%}<li>{{ tag | remove: 'event:' | replace: '-', ' ' | capitalize | escape }}</li>
              {%- elsif tag == 'everyday wear' or tag == 'signature' or tag == 'wedding/formal' -%}<li>{{ tag | capitalize | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          {%- endcapture -%}
          {%- if occasions != blank -%}<section><h2>Best for</h2><ul>{{ occasions }}</ul></section>{%- endif -%}
          <section><h2>What you get</h2><ul>
            <li>A 5ml glass spray atomizer, about 60 sprays</li>
            <li>Decanted from the original bottle{% if concentration != blank %}, {{ concentration | strip | downcase }}{% endif %}</li>
            <li>First vial $20, each extra vial in the same order $18</li>
          </ul></section>
        </div>
      </div>

      <section class="artifact-product__reviews" aria-labelledby="ArtifactReviewsTitle" data-reviews-section>
        <h2 id="ArtifactReviewsTitle">Reviews</h2>
        <div style="clear:both"></div>
        <div id="judgeme_product_reviews" class="jdgm-widget jdgm-review-widget" data-product-title="{{ product.title | escape }}" data-id="{{ product.id }}">{{ product.metafields.judgeme.widget }}</div>
      </section>
      <script>
        (function () {
          'use strict';
          var sec = document.querySelector('[data-reviews-section]');
          var box = document.getElementById('judgeme_product_reviews');
          if (!sec || !box) return;
          var MIN = 40;
          function sync() {
            if (box.offsetHeight > MIN) { sec.removeAttribute('data-reviews-empty'); return true; }
            return false;
          }
          if (!sync()) sec.setAttribute('data-reviews-empty', '');
          var waited = 0, STEP = 250, DEADLINE = 8000;
          var timer = setInterval(function () {
            if (sync() || (waited += STEP) >= DEADLINE) clearInterval(timer);
          }, STEP);
          try {
            new MutationObserver(sync).observe(box, { childList: true, subtree: true });
          } catch (e) {}
        })();
      </script>
      {%- if section.blocks.size > 0 -%}
        <div class="artifact-product__app-blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      {% render 'review-scroll-assist' %}
    </div>
    <script type="application/json" data-artifact-variants>[
      {%- for variant in product.variants -%}
        {%- assign allocation = variant.selling_plan_allocations.first -%}
        {"id":{{ variant.id | json }},"title":{{ variant.title | json }},"price":{{ variant.price | json }},"available":{{ variant.available | json }},"isVial":{% if variant.id == vial_variant.id %}true{% else %}false{% endif %},"planId":{% if variant.id == vial_variant.id and variant.price == 2000 %}{{ allocation.selling_plan.id | json }}{% else %}null{% endif %},"planPrice":{{ allocation.price | json }},"renewalPrice":{{ allocation.price_adjustments.last.price | default: variant.price | json }}}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]</script>
  </artifact-product>

  <script>
    (function () {
      'use strict';
      var root = document.querySelector('[data-artifact-queue]');
      if (!root) return;

      var loggedIn = root.getAttribute('data-logged-in') === 'true';
      var rotation = document.querySelector('[data-artifact-rotation]');
      var queueOpt = rotation && rotation.querySelector('[data-queue-option]');
      var monthEl = root.querySelector('[data-artifact-queue-month]');
      var chip = root.querySelector('[data-queue-chip]');
      var nextEl = root.querySelector('[data-queue-next]');
      var ok = root.querySelector('[data-queue-ok]');
      var warn = root.querySelector('[data-queue-warn]');
      var note = document.querySelector('[data-artifact-rotation-note]');
      var plan = document.querySelector('[data-artifact-plan]');
      var consent = document.querySelector('[data-artifact-consent]');
      var submit = document.querySelector('[data-artifact-submit]');
      var status = document.querySelector('[data-artifact-product-status]');
      var title = root.getAttribute('data-product-title') || 'this scent';
      var vendor = root.getAttribute('data-product-vendor') || '';
      var host = document.querySelector('artifact-product');
      var handle = host ? host.getAttribute('data-product-handle') : '';
      var imgEl = document.querySelector('[data-product-main-image]');

      function hasQueue() {
        return !!(window.BasenoteQueue && typeof window.BasenoteQueue.setSlot === 'function');
      }
      function isSub() { return loggedIn && hasQueue(); }
      function monthKey() { return String(monthEl.value || '').slice(0, 7); }
      function monthLabel() {
        if (hasQueue() && window.BasenoteQueue.monthLabel) {
          return window.BasenoteQueue.monthLabel(monthKey(), { withYear: true });
        }
        return monthEl.options[monthEl.selectedIndex].text.replace(/\s*\(.*\)/, '');
      }

      function fillMonthsFromQueue() {
        if (!hasQueue() || !monthEl) return;
        var months = window.BasenoteQueue.slotsFromNow(5);
        if (!months || !months.length) return;
        monthEl.innerHTML = months.map(function (m, i) {
          var label = window.BasenoteQueue.monthLabel(m, { withYear: true });
          if (i === 0) label += ' (next shipment)';
          return '<option value="' + m + '"' + (i === 1 ? ' selected' : '') + '>' + label + '</option>';
        }).join('');
        if (nextEl && months[0]) {
          nextEl.textContent = window.BasenoteQueue.monthLabel(months[0], { withYear: true });
        }
      }

      function setQueueMode(on) {
        root.hidden = !on;
        monthEl.disabled = !on;
        if (chip) chip.hidden = !(on && isSub());
        if (note && on) note.hidden = true;
        if (plan && on) { plan.value = ''; plan.disabled = true; }
        if (consent && on) { consent.checked = false; consent.disabled = true; }
      }

      function sync() {
        var mode = rotation ? rotation.value : '';
        if (mode === 'queue' && !loggedIn) {
          window.location.href = '/account/login?return_to=' + encodeURIComponent(window.location.pathname + window.location.search);
          rotation.value = '';
          mode = '';
        }
        setQueueMode(mode === 'queue' && loggedIn);
        if (ok && mode !== 'queue') ok.hidden = true;
        if (warn) warn.hidden = true;
        if (submit && !submit.disabled) {
          if (mode === 'queue' && loggedIn) submit.textContent = 'Add ' + title + ' to queue';
          else if (mode === 'subscription') submit.textContent = 'Start Monthly Rotation';
          else submit.textContent = 'Add to cart';
        }
      }

      function variantId() {
        var checked = document.querySelector('[data-artifact-size]:checked');
        return checked ? checked.value : '';
      }

      function goToQueue() {
        window.location.href = '/account#next-shipment';
      }

      function queueThisScent(e) {
        if (!rotation || rotation.value !== 'queue') return;
        e.preventDefault();
        e.stopPropagation();
        if (!loggedIn) {
          window.location.href = '/account/login?return_to=' + encodeURIComponent(window.location.pathname + window.location.search);
          return;
        }
        var m = monthKey();
        var payload = {
          productId: variantId(),
          title: title,
          url: handle ? ('/products/' + handle) : window.location.pathname,
          image: imgEl && (imgEl.currentSrc || imgEl.src) ? (imgEl.currentSrc || imgEl.src) : '',
          family: vendor,
          handle: handle,
          shipMonth: m
        };
        try {
          sessionStorage.setItem('bn_pdp_queue_pending', JSON.stringify({ month: m, entry: payload }));
        } catch (err) {}
        window.__bqPendingTargetMonth = m;

        if (!hasQueue()) {
          goToQueue();
          return;
        }

        if (ok) { ok.hidden = false; ok.textContent = 'Queued. Opening your Rotation queue…'; }

        var result = window.BasenoteQueue.setSlot(m, payload);
        if (result && typeof result.then === 'function') {
          result.then(goToQueue).catch(goToQueue);
          return;
        }
        setTimeout(goToQueue, 80);
      }

      if (rotation) rotation.addEventListener('change', sync);
      if (monthEl) monthEl.addEventListener('change', function () { if (ok) ok.hidden = true; });
      if (submit) submit.addEventListener('click', queueThisScent, true);

      function targetMonthFromUrl() {
        try {
          var q = new URLSearchParams(window.location.search).get('queue_target_month');
          return q ? String(q).slice(0, 7) : '';
        } catch (e) { return ''; }
      }

      function applyUrlTarget() {
        var target = targetMonthFromUrl();
        if (!target || !monthEl) return;
        var found = false;
        Array.prototype.forEach.call(monthEl.options, function (opt) {
          if (opt.value === target) found = true;
        });
        if (!found) {
          var label = hasQueue() && window.BasenoteQueue.monthLabel
            ? window.BasenoteQueue.monthLabel(target, { withYear: true })
            : target;
          monthEl.appendChild(new Option(label, target, true, true));
        }
        monthEl.value = target;
        if (loggedIn && queueOpt) {
          queueOpt.hidden = false;
          rotation.value = 'queue';
        }
      }

      function ready(n) {
        n = n || 0;
        if (queueOpt) queueOpt.hidden = !loggedIn;
        if (hasQueue()) {
          fillMonthsFromQueue();
          applyUrlTarget();
          sync();
          return;
        }
        if (n > 40) { applyUrlTarget(); sync(); return; }
        setTimeout(function () { ready(n + 1); }, 50);
      }
      ready();
    })();
  </script>
  <!-- INTERNAL_ADDON_PURCHASE_UI_END -->
{%- endunless -%}

