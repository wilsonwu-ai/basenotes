{%- liquid
  assign vial_variant = product.selected_or_first_available_variant
  assign bottle_variant = blank
  for candidate in product.variants
    assign candidate_title = candidate.title | downcase
    if candidate_title contains '100ml' or candidate_title contains '100 ml' or candidate_title contains '3.3' or candidate_title contains 'full bottle'
      assign bottle_variant = candidate
    else
      assign vial_variant = candidate
    endif
  endfor
  assign vial_plan = vial_variant.selling_plan_allocations.first.selling_plan
  assign display_title = product.title | remove_first: product.vendor | remove: 'EDP' | remove: 'Eau de Parfum' | strip
  capture concentration
    render 'product-concentration', product: product
  endcapture
  assign is_internal_addon_product = false
  if product.handle == 'extra-5ml-vial-add-on'
    assign is_internal_addon_product = true
  endif
-%}

{%- if is_internal_addon_product -%}
  <!-- INTERNAL_ADDON_GUARD_COPY_START -->
  <section class="artifact-product artifact-product--guard">
    <a class="artifact-product__back" href="{{ routes.all_products_collection_url }}">← All fragrances</a>
    <div class="artifact-product__guard" data-internal-addon-route-guard><p class="artifact-product__eyebrow">Subscriber add-on</p><h1>This item is added from your scent queue.</h1><p>Choose a fragrance from the collection to start.</p><button type="button" disabled>Available inside your scent queue</button><a href="/collections/fragrances">Shop fragrances</a></div>
  </section>
  <!-- INTERNAL_ADDON_GUARD_COPY_END -->
{%- endif -%}
{%- unless is_internal_addon_product -%}
<!-- INTERNAL_ADDON_PURCHASE_UI_START -->
<artifact-product class="artifact-product" data-vial-id="{{ vial_variant.id }}" data-vial-price="{{ vial_variant.price }}" data-bottle-id="{{ bottle_variant.id }}" data-bottle-price="{{ bottle_variant.price | default: 36000 }}" data-bottle-available="{{ bottle_variant.available }}" data-plan-id="{{ vial_plan.id }}">
  <div class="artifact-product__shell">
    <a class="artifact-product__back" href="/collections/fragrances">← All fragrances</a>
    <div class="artifact-product__top">
      <div class="artifact-product__visual" aria-label="5ml atomizer shown next to a full bottle, true to scale">
        <svg class="artifact-product__scale" viewBox="0 0 520 600" role="img" aria-labelledby="ArtifactScaleTitle-{{ section.id }}">
          <title id="ArtifactScaleTitle-{{ section.id }}">Base Note 5ml vial and 100ml full bottle size comparison</title>
          <defs><linearGradient id="ArtifactGlass-{{ section.id }}" x1="0" x2="1"><stop stop-color="#fff" stop-opacity=".92"/><stop offset=".52" stop-color="#d7ddd9" stop-opacity=".34"/><stop offset="1" stop-color="#7d9189" stop-opacity=".52"/></linearGradient></defs>
          <g transform="translate(72 255)"><rect x="40" y="0" width="42" height="36" fill="none" stroke="#ac9159"/><rect x="31" y="36" width="60" height="25" rx="5" fill="#f4efe3" stroke="#ac9159"/><rect x="13" y="61" width="96" height="190" rx="25" fill="url(#ArtifactGlass-{{ section.id }})" stroke="#ac9159"/><path d="M21 156h80v70c0 13-10 22-22 22H43c-12 0-22-9-22-22Z" fill="#22392b"/><rect x="26" y="98" width="70" height="70" fill="#f4efe3"/><text x="61" y="124" text-anchor="middle" font-size="10" fill="#22392b">BASE NOTE</text><text x="61" y="145" text-anchor="middle" font-size="7" fill="#5c574d">{{ display_title | upcase | truncate: 16 | escape }}</text><text x="61" y="285" text-anchor="middle" font-size="11" fill="#5c574d">5ML</text></g>
          <g transform="translate(250 70)"><rect x="76" y="0" width="74" height="64" fill="none" stroke="#ac9159"/><rect x="57" y="64" width="112" height="37" rx="7" fill="#f4efe3" stroke="#ac9159"/><path d="M21 101h184l21 386H0Z" fill="#22392b" stroke="#ac9159"/><rect x="45" y="205" width="136" height="116" fill="none" stroke="#ac9159"/><text x="113" y="529" text-anchor="middle" font-size="11" fill="#5c574d">100ML</text></g>
          <text x="260" y="580" text-anchor="middle" font-size="11" fill="#7a756d">5ml atomizer shown next to the full 100ml bottle, true to scale</text>
        </svg>
      </div>

      <div class="artifact-product__info">
        <p class="artifact-product__eyebrow">{{ product.vendor }}</p>
        <h1>{{ display_title | default: product.title }}</h1>
        <p class="artifact-product__meta">{{ concentration | strip }} <span aria-hidden="true">·</span> {{ product.metafields.custom.made_in | default: 'Decanted to 5ml' }}</p>
        {% render 'product-review-badge', product: product, surface: 'product' %}
        <div class="artifact-product__pills" aria-label="Fragrance character">
          {%- assign pills_shown = 0 -%}
          {%- for pill in product.tags -%}
            {%- assign pill_down = pill | downcase -%}
            {%- if pill contains ':' or pill_down == 'date night' or pill_down == 'everyday wear' or pill_down == 'signature' or pill_down == 'wedding/formal' -%}{%- continue -%}{%- endif -%}
            <span>{{ pill | strip }}</span>{%- assign pills_shown = pills_shown | plus: 1 -%}
            {%- if pills_shown == 5 -%}{%- break -%}{%- endif -%}
          {%- endfor -%}
          {%- if pills_shown == 0 -%}<span>Authentic</span><span>Travel ready</span><span>Signature scent</span>{%- endif -%}
        </div>

        <fieldset class="artifact-product__sizes">
          <legend class="visually-hidden">Choose a size</legend>
          <button type="button" class="artifact-product__size artifact-product__size--active" data-artifact-size="vial" aria-pressed="true">5ml</button>
          <button type="button" class="artifact-product__size" data-artifact-size="bottle" aria-pressed="false">Full bottle <span>(3.3oz)</span></button>
        </fieldset>

        <p class="artifact-product__price" data-artifact-product-price aria-label="Price {{ vial_variant.price | money }}">{{ vial_variant.price | money }}</p>
        {%- form 'product', product, class: 'artifact-product__form', data-product-form: '', data-artifact-product-form: '' -%}
          <input type="hidden" name="id" value="{{ vial_variant.id }}" data-artifact-variant>
          <input type="hidden" name="selling_plan" value="" data-artifact-plan disabled>
          <div class="artifact-product__quantity">
            <button type="button" data-artifact-qty="minus" aria-label="Decrease quantity">−</button>
            <label class="visually-hidden" for="ArtifactQuantity-{{ section.id }}">Quantity</label>
            <input id="ArtifactQuantity-{{ section.id }}" type="number" name="quantity" value="1" min="1" inputmode="numeric" data-artifact-quantity>
            <button type="button" data-artifact-qty="plus" aria-label="Increase quantity">+</button>
          </div>
          <button id="addToCartButton" class="artifact-product__add" type="submit" data-artifact-submit>Add to cart</button>
        {%- endform -%}
        <p class="artifact-product__size-note" data-artifact-size-note>5ml holds about 60 sprays — roughly a month of regular wear.</p>
        <p class="artifact-product__shipping">▱ Ships within 1–3 business days</p>
        {%- if vial_plan != blank -%}
          <button id="monthly-rotation" type="button" class="artifact-product__rotation" data-artifact-rotation aria-pressed="false">Prefer a subscription? Choose Monthly Rotation</button>
          <p class="artifact-product__rotation-note" data-artifact-rotation-note hidden>Monthly Rotation is a recurring subscription. First shipment {{ vial_variant.selling_plan_allocations.first.price | money }}, then {{ vial_variant.price | money }} monthly. Swap, pause, or cancel anytime.</p>
        {%- endif -%}
      </div>
    </div>

    <div class="artifact-product__story">
      <div class="artifact-product__description">{{ product.description }}</div>
      <div class="artifact-product__details">
        <section><h2>Key notes</h2><div class="artifact-product__notes">
          <div><span>Top</span><p>{{ product.metafields.custom.top_notes | default: 'See fragrance details' }}</p></div>
          <div><span>Heart</span><p>{{ product.metafields.custom.heart_notes | default: 'Authentic house composition' }}</p></div>
          <div><span>Base</span><p>{{ product.metafields.custom.base_notes | default: 'Long-lasting drydown' }}</p></div>
        </div></section>
        <section><h2>Best for</h2><ul><li>Everyday signature scent</li><li>Work, evenings, and weekends</li><li>Trying on skin before a full bottle</li></ul></section>
      </div>
    </div>
  </div>
  <p class="artifact-product__status" data-artifact-product-status role="status" aria-live="polite"></p>
</artifact-product>
<!-- INTERNAL_ADDON_PURCHASE_UI_END -->
{%- endunless -%}

{% stylesheet %}
  .artifact-product { --ap-green:#22392b; --ap-cream:#f4efe3; --ap-gold:#ac9159; --ap-ink:#242320; --ap-muted:#5c574d; --ap-line:rgb(34 57 43 / 18%); display:block; min-height:70dvh; color:var(--ap-ink); background:var(--ap-cream); }
  .artifact-product__shell { width:min(100% - 3rem,68rem); margin-inline:auto; padding-block:2.1rem 5rem; }
  .artifact-product__back { display:inline-block; margin-block-end:2rem; padding-block-end:.2rem; border-block-end:.0625rem solid var(--ap-gold); color:var(--ap-green); font:.72rem/1.3 'Jost',sans-serif; }
  .artifact-product__top { display:grid; grid-template-columns:minmax(0,1fr) minmax(22rem,.92fr); gap:3.75rem; align-items:center; }
  .artifact-product__visual { display:grid; min-height:31rem; place-items:center; border:.0625rem solid var(--ap-line); border-radius:.2rem; }
  .artifact-product__scale { width:min(88%,30rem); height:auto; }
  .artifact-product__info { min-width:0; }
  .artifact-product__eyebrow { margin:0 0 .8rem; color:var(--ap-gold); font:500 .7rem/1.2 'Jost',sans-serif; letter-spacing:.16em; text-transform:uppercase; }
  .artifact-product__info h1 { margin:0; font:700 clamp(2.6rem,5vw,4rem)/1 'Playfair Display',serif; letter-spacing:-.035em; }
  .artifact-product__meta { margin:.7rem 0 1rem; color:var(--ap-muted); font:.75rem/1.5 'Jost',sans-serif; }
  .artifact-product .product-review-badge { margin-block:0 1rem; }
  .artifact-product__pills { display:flex; flex-wrap:wrap; gap:.45rem; margin-block-end:1.3rem; }
  .artifact-product__pills span { padding:.42rem .7rem; border:.0625rem solid var(--ap-gold); border-radius:99rem; color:var(--ap-green); font:500 .62rem/1 'Jost',sans-serif; letter-spacing:.06em; text-transform:uppercase; }
  .artifact-product__sizes { display:grid; grid-template-columns:7rem minmax(10rem,1fr); width:min(100%,25rem); margin:0 0 1.2rem; padding:0; border:0; }
  .artifact-product__size { min-height:3.1rem; padding:.75rem; border:.0625rem solid var(--ap-green); color:var(--ap-green); background:transparent; font:500 .7rem/1 'Jost',sans-serif; letter-spacing:.08em; text-transform:uppercase; cursor:pointer; }
  .artifact-product__size + .artifact-product__size { border-inline-start:0; }
  .artifact-product__size--active { color:var(--ap-cream); background:var(--ap-green); }
  .artifact-product__price { margin:0 0 1.1rem; font:500 2.1rem/1 'Jost',sans-serif; }
  .artifact-product__quantity { display:grid; grid-template-columns:2.8rem 2.8rem 2.8rem; width:max-content; margin-block-end:1rem; border:.0625rem solid var(--ap-line); }
  .artifact-product__quantity button,.artifact-product__quantity input { width:2.8rem; height:2.8rem; border:0; color:var(--ap-ink); background:transparent; text-align:center; font:500 .85rem/1 'Jost',sans-serif; }
  .artifact-product__quantity button { cursor:pointer; }
  .artifact-product__quantity input { appearance:textfield; }
  .artifact-product__add { width:min(100%,25rem); min-height:3.65rem; border:.0625rem solid var(--ap-green); color:var(--ap-cream); background:var(--ap-green); font:500 .76rem/1 'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; cursor:pointer; transition:color 160ms ease,background 160ms ease; }
  .artifact-product__add:hover,.artifact-product__add:focus-visible { color:var(--ap-green); background:transparent; }
  .artifact-product__add[disabled] { cursor:not-allowed; opacity:.55; }
  .artifact-product__size-note,.artifact-product__shipping { margin:.8rem 0 0; color:var(--ap-muted); font:.72rem/1.45 'Jost',sans-serif; }
  .artifact-product__rotation { margin-block-start:1.15rem; padding:0 0 .2rem; border:0; border-block-end:.0625rem solid var(--ap-gold); color:var(--ap-green); background:transparent; font:.72rem/1.4 'Jost',sans-serif; cursor:pointer; }
  .artifact-product__rotation-note { max-width:29rem; margin:.75rem 0 0; color:var(--ap-muted); font:.72rem/1.5 'Jost',sans-serif; }
  .artifact-product__story { margin-block-start:3rem; padding-block-start:2.5rem; border-block-start:.0625rem solid var(--ap-line); }
  .artifact-product__description { max-width:57rem; color:var(--ap-muted); font:italic 1rem/1.7 'EB Garamond',serif; }
  .artifact-product__description p { margin-block:0 1rem; }
  .artifact-product__details { display:grid; grid-template-columns:1fr 1fr; gap:2.5rem; margin-block-start:2.25rem; }
  .artifact-product__details h2 { margin:0 0 .8rem; padding-block-end:.6rem; border-block-end:.0625rem solid var(--ap-line); font:600 .72rem/1.2 'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  .artifact-product__notes { display:grid; grid-template-columns:repeat(3,1fr); }
  .artifact-product__notes div { min-width:0; padding-inline:.8rem; border-inline-start:.125rem solid var(--ap-gold); }
  .artifact-product__notes span { color:var(--ap-gold); font:500 .6rem/1 'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  .artifact-product__notes p,.artifact-product__details li { margin:.5rem 0 0; color:var(--ap-muted); font:.85rem/1.45 'EB Garamond',serif; }
  .artifact-product__details ul { margin:0; padding-inline-start:1.1rem; }
  .artifact-product__details li::marker { color:var(--ap-gold); }
  .artifact-product__status { position:fixed; z-index:5; inset:auto 1rem 1rem auto; margin:0; padding:.8rem 1rem; color:var(--ap-cream); background:var(--ap-green); font:.78rem/1.4 'Jost',sans-serif; opacity:0; pointer-events:none; transition:opacity 180ms ease; }
  .artifact-product__status--visible { opacity:1; }
  .artifact-product__guard { width:min(100% - 3rem,40rem); margin-inline:auto; padding-block:7rem; text-align:center; }
  .artifact-product__guard h1 { font:700 3rem/1.05 'Playfair Display',serif; }
  .artifact-product__guard a { display:inline-block; margin-block-start:1.5rem; padding:.9rem 1.4rem; color:var(--ap-cream); background:var(--ap-green); font:.75rem/1 'Jost',sans-serif; text-transform:uppercase; }
  @media (max-width:52rem) { .artifact-product__top { grid-template-columns:1fr; gap:2rem; } .artifact-product__visual { min-height:25rem; } .artifact-product__info { width:min(100%,34rem); margin-inline:auto; } }
  @media (max-width:40rem) { .artifact-product__shell { width:min(100% - 2rem,68rem); padding-block-start:1.35rem; } .artifact-product__top { gap:1.5rem; } .artifact-product__visual { min-height:21rem; } .artifact-product__scale { width:min(90%,22rem); } .artifact-product__details { grid-template-columns:1fr; } .artifact-product__sizes,.artifact-product__add { width:100%; } .artifact-product__quantity input { font-size:1rem; } }
  @media (prefers-reduced-motion:reduce) { .artifact-product__add,.artifact-product__status { transition:none; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('artifact-product')) {
    customElements.define('artifact-product', class extends HTMLElement {
      connectedCallback() {
        this.variant=this.querySelector('[data-artifact-variant]'); this.plan=this.querySelector('[data-artifact-plan]'); this.price=this.querySelector('[data-artifact-product-price]'); this.submit=this.querySelector('[data-artifact-submit]'); this.note=this.querySelector('[data-artifact-size-note]'); this.quantity=this.querySelector('[data-artifact-quantity]'); this.rotation=false;
        this.querySelectorAll('[data-artifact-size]').forEach((button)=>button.addEventListener('click',()=>this.setSize(button.dataset.artifactSize)));
        this.querySelectorAll('[data-artifact-qty]').forEach((button)=>button.addEventListener('click',()=>{const delta=button.dataset.artifactQty==='plus'?1:-1; this.quantity.value=Math.max(1,Number(this.quantity.value||1)+delta);}));
        this.querySelector('[data-artifact-rotation]')?.addEventListener('click',(event)=>{this.rotation=!this.rotation; event.currentTarget.setAttribute('aria-pressed',String(this.rotation)); event.currentTarget.textContent=this.rotation?'Monthly Rotation selected':'Prefer a subscription? Choose Monthly Rotation'; this.plan.disabled=!this.rotation; this.plan.value=this.rotation?this.dataset.planId:''; this.querySelector('[data-artifact-rotation-note]').hidden=!this.rotation;});
        this.querySelector('[data-artifact-product-form]')?.addEventListener('submit',(event)=>this.add(event));
      }
      money(cents){return new Intl.NumberFormat(document.documentElement.lang||'en-US',{style:'currency',currency:'USD',maximumFractionDigits:0}).format(Number(cents)/100);}
      setSize(size){const bottle=size==='bottle'; this.querySelectorAll('[data-artifact-size]').forEach((button)=>{const active=button.dataset.artifactSize===size; button.classList.toggle('artifact-product__size--active',active); button.setAttribute('aria-pressed',String(active));}); this.rotation=false; if(this.plan){this.plan.disabled=true;this.plan.value='';} this.variant.value=bottle?this.dataset.bottleId:this.dataset.vialId; this.price.textContent=this.money(bottle?this.dataset.bottlePrice:this.dataset.vialPrice); this.note.textContent=bottle?'Authentic full bottle, priced below regular retail.': '5ml holds about 60 sprays — roughly a month of regular wear.'; const available=!bottle||this.dataset.bottleAvailable==='true'; this.submit.disabled=!available; this.submit.textContent=available?'Add to cart':'Request full bottle'; if(!available){this.submit.type='button';this.submit.onclick=()=>{window.location.href='mailto:hello@basenotescent.com?subject='+encodeURIComponent('Full bottle request: '+document.querySelector('h1')?.textContent.trim());};}else{this.submit.type='submit';this.submit.onclick=null;} }
      async add(event){event.preventDefault(); if(this.submit.disabled)return; this.submit.disabled=true; const data=new FormData(event.currentTarget); try{const response=await fetch('/cart/add.js',{method:'POST',headers:{Accept:'application/json'},body:data});if(!response.ok)throw new Error('add failed');const status=this.querySelector('[data-artifact-product-status]');status.textContent='Added to your cart.';status.classList.add('artifact-product__status--visible');setTimeout(()=>status.classList.remove('artifact-product__status--visible'),2200);document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}));}catch(error){event.currentTarget.submit();}finally{this.submit.disabled=false;}}
    });
  }
{% endjavascript %}

{% schema %}
{"name":"Claude artifact product","settings":[],"presets":[{"name":"Claude artifact product"}]}
{% endschema %}
