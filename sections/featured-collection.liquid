{%- liquid
  assign collection = section.settings.collection
  if collection == blank
    assign products_to_show = 10
  else
    assign products_to_show = section.settings.products_to_show
  endif
-%}

{%- comment -%}
  Featured collection — Base Note facelift, Phase A, Direction A.

  Editorial 3-up on desktop: the first card takes a 2×2 block so the grid has a
  lead item instead of twelve equal tiles. Below 900px the same grid becomes a
  horizontal scroll-snap row (growth memo §4.2 — carousel, not grid).

  The card itself is untouched: {% render 'product-card' %} is the same call it
  always was, now also passed catalogue_number so the grid can number the
  catalogue (§4.6). Every funnel hook lives inside that snippet and stays there.
{%- endcomment -%}

<section class="section section--cream bn-fc" id="collection">
  <div class="container">
    <div class="bn-fc__header" data-reveal-group>
      {%- if section.settings.eyebrow != blank -%}
        <span class="section__eyebrow bn-fc__eyebrow" data-reveal>{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      <h2 class="section__title bn-fc__title" data-reveal>
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <em class="bn-fc__accent">{{ section.settings.heading_accent }}</em>
        {%- endif -%}
      </h2>

      {%- if section.settings.description != blank -%}
        <p class="section__description bn-fc__description" data-reveal>{{ section.settings.description }}</p>
      {%- endif -%}
    </div>

    <div class="featured-grid bn-fc__grid" data-reveal-group>
      {%- if collection != blank -%}
        {%- for product in collection.products limit: products_to_show -%}
          {% render 'product-card', product: product, catalogue_number: forloop.index %}
        {%- endfor -%}
      {%- else -%}
        {% comment %} Placeholder products for preview {% endcomment %}
        {%- assign placeholder_names = "Noir Absolu,Amber Elixir,Rose Oud,Bergamot Mist,Velvet Tonka,Sandalwood Dreams,Iris Midnight,Cedar Smoke,Jasmine Imperial,Leather & Spice" | split: "," -%}
        {%- assign placeholder_notes = "Dark chocolate, Oud, Leather|Amber, Vanilla, Benzoin|Bulgarian Rose, Oud, Saffron|Bergamot, White Tea, Musk|Tonka Bean, Almond, Praline|Sandalwood, Cedarwood, Vetiver|Iris, Violet, Suede|Cedar, Birch, Smoke|Jasmine, Tuberose, Gardenia|Leather, Cardamom, Black Pepper" | split: "|" -%}
        {%- assign placeholder_families = "woody,amber,floral,fresh,gourmand,woody,powdery,smoky,floral,leather" | split: "," -%}
        {%- for i in (1..10) -%}
          {%- assign index = forloop.index0 -%}
          <article class="product-card bn-fc__ph" data-family="{{ placeholder_families[index] }}">
            <a href="#" class="product-card__link">
              <div class="product-card__image">
                {%- if forloop.index == 1 -%}
                  <span class="product-card__badge product-card__badge--new">New</span>
                {%- elsif forloop.index == 3 -%}
                  <span class="product-card__badge product-card__badge--bestseller">Bestseller</span>
                {%- endif -%}
                <div class="product-card__placeholder">
                  <svg viewBox="0 0 60 100" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="15" y="25" width="30" height="65" rx="3"/>
                    <rect x="20" y="10" width="20" height="15"/>
                    <rect x="25" y="2" width="10" height="8" rx="2"/>
                    <text x="30" y="62" text-anchor="middle" font-size="8" fill="currentColor" stroke="none">BN</text>
                  </svg>
                </div>
              </div>

              <div class="product-card__info">
                {%- assign ph_no = forloop.index -%}
                {%- if ph_no < 10 -%}
                  <span class="product-card__number">No. 0{{ ph_no }}</span>
                {%- else -%}
                  <span class="product-card__number">No. {{ ph_no }}</span>
                {%- endif -%}
                <span class="product-card__brand">Base Note Atelier</span>
                <h3 class="product-card__title">{{ placeholder_names[index] }}</h3>
                <p class="product-card__notes">{{ placeholder_notes[index] }}</p>
                <div class="product-card__footer">
                  <span class="product-card__price">$20</span>
                  <span class="product-card__plan-label">Monthly Subscription</span>
                </div>
              </div>
            </a>
            <button class="product-card__add-btn" type="button">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Add to Queue
            </button>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="bn-fc__viewall-wrap" data-reveal>
        <a href="{{ collection.url }}" class="bn-fc__viewall" data-magnetic>
          <em>{{ section.settings.view_all_label | default: 'View all' }}</em>
          <span class="bn-fc__viewall-meta">{{ collection.all_products_count }} fragrances · one flat price</span>
          <span class="bn-fc__ar" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  /* ==========================================================================
     Featured collection — Direction A "Editorial Grotesque".
     Everything is scoped to .bn-fc so the shared .section__* classes keep their
     base.css behaviour everywhere else on the site.
     ========================================================================== */
  .bn-fc {
    background: var(--bn-bone-2);
  }

  /* --- Header ------------------------------------------------------------- */
  .bn-fc .bn-fc__header {
    text-align: left;
    max-width: none;
    margin: 0 0 var(--bn-space-2xl);
  }

  .bn-fc .bn-fc__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--bn-space-xs);
    margin: 0 0 var(--bn-space-sm);
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    color: var(--bn-brass-ink);
  }

  .bn-fc .bn-fc__eyebrow::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--bn-line-on-bone);
  }

  .bn-fc .bn-fc__title {
    margin: 0;
    max-width: 18ch;
    font-family: var(--bn-font-display);
    font-variation-settings: var(--bn-display-vf);
    font-weight: var(--bn-weight-display);
    font-size: var(--bn-text-3xl);
    line-height: var(--bn-leading-display);
    letter-spacing: var(--bn-track-display);
    text-transform: none;
    color: var(--bn-text-on-bone);
  }

  .bn-fc .bn-fc__accent {
    display: block;
    font-family: var(--bn-font-accent);
    font-style: italic;
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: -0.02em;
    color: var(--bn-brass-ink);
  }

  .bn-fc .bn-fc__description {
    max-width: 46ch;
    margin: var(--bn-space-md) 0 0;
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-base);
    line-height: var(--bn-leading-body);
    color: var(--bn-text-on-bone-dim);
  }

  /* --- Grid: editorial 3-up, first card takes a 2x2 block ------------------ */
  .bn-fc .bn-fc__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: var(--bn-gutter);
    max-width: none;
    margin: 0;
  }

  .bn-fc .bn-fc__grid > .product-card:first-child {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* The lead card gives up its fixed 3:4 crop and fills the taller block. */
  .bn-fc .bn-fc__grid > .product-card:first-child .product-card__media {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 0;
  }

  .bn-fc .bn-fc__grid > .product-card:first-child .product-card__content {
    padding: var(--bn-space-md);
  }

  .bn-fc .bn-fc__grid > .product-card:first-child .product-card__title {
    font-size: var(--bn-text-2xl);
    min-height: 0;
  }

  /* Same treatment for the editor-preview placeholder, matched by structure so
     it can never touch a real card (there .product-card__image is the <img>). */
  .bn-fc .bn-fc__grid > .product-card:first-child > .product-card__link > .product-card__image {
    aspect-ratio: auto;
    flex: 1 1 auto;
    min-height: 240px;
  }

  /* --- Mobile: horizontal scroll-snap row (memo §4.2) ---------------------- */
  @media (max-width: 900px) {
    .bn-fc .bn-fc__grid {
      display: flex;
      grid-auto-rows: auto;
      gap: var(--bn-space-md);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-left: 0;
      padding-bottom: var(--bn-space-md);
      -webkit-overflow-scrolling: touch;
    }

    .bn-fc .bn-fc__grid > .product-card {
      flex: 0 0 76%;
      max-width: 340px;
      scroll-snap-align: start;
    }

    .bn-fc .bn-fc__grid > .product-card:first-child {
      grid-column: auto;
      grid-row: auto;
    }

    .bn-fc .bn-fc__grid > .product-card:first-child .product-card__media {
      aspect-ratio: 3 / 4;
      flex: none;
    }

    .bn-fc .bn-fc__grid > .product-card:first-child .product-card__title {
      font-size: var(--bn-text-lg);
    }

    .bn-fc .bn-fc__grid > .product-card:first-child > .product-card__link > .product-card__image {
      aspect-ratio: 3 / 4;
      flex: none;
      min-height: 0;
    }
  }

  /* --- Giant italic "View all" -------------------------------------------- */
  .bn-fc .bn-fc__viewall-wrap {
    margin-top: var(--bn-space-2xl);
    padding-top: var(--bn-space-lg);
    border-top: 1px solid var(--bn-line-on-bone);
  }

  .bn-fc .bn-fc__viewall {
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--bn-space-md);
    text-decoration: none;
    color: var(--bn-text-on-bone);
  }

  .bn-fc .bn-fc__viewall em {
    font-family: var(--bn-font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: var(--bn-text-3xl);
    line-height: 1;
    letter-spacing: -0.02em;
    transition: color var(--bn-dur-fast) var(--bn-ease);
  }

  .bn-fc .bn-fc__viewall-meta {
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    color: var(--bn-text-on-bone-dim);
  }

  .bn-fc .bn-fc__ar {
    display: inline-block;
    font-size: var(--bn-text-lg);
    transition: transform var(--bn-dur-fast) var(--bn-ease);
  }

  .bn-fc .bn-fc__viewall:hover em {
    color: var(--bn-brass-ink);
  }

  .bn-fc .bn-fc__viewall:hover .bn-fc__ar {
    transform: translateX(6px);
  }

  /* ==========================================================================
     Editor-preview placeholder only. Scoped to .bn-fc__ph so none of it can
     reach a real product card rendered by snippets/product-card.liquid.
     ========================================================================== */
  .bn-fc .bn-fc__ph {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--bn-bone);
    border: 1px solid var(--bn-line-on-bone);
    border-radius: var(--bn-radius-md);
    overflow: hidden;
  }

  .bn-fc .bn-fc__ph:hover {
    border-color: var(--bn-ink);
  }

  .bn-fc .bn-fc__ph .product-card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .bn-fc .bn-fc__ph .product-card__image {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bn-bone-2);
    background: color-mix(in oklab, var(--bn-family, var(--bn-family-default)) 15%, var(--bn-bone));
  }

  .bn-fc .bn-fc__ph .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bn-text-on-bone-dim);
  }

  .bn-fc .bn-fc__ph .product-card__placeholder svg {
    width: 46%;
    max-width: 90px;
    opacity: 0.55;
  }

  .bn-fc .bn-fc__ph .product-card__badge {
    position: absolute;
    top: var(--bn-space-2xs);
    left: var(--bn-space-2xs);
    z-index: 2;
    padding: 5px 9px;
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    border-radius: var(--bn-radius-sm);
    background: var(--bn-ink);
    color: var(--bn-text-on-ink);
  }

  .bn-fc .bn-fc__ph .product-card__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: var(--bn-space-sm) var(--bn-space-sm) var(--bn-space-xs);
    text-align: left;
  }

  .bn-fc .bn-fc__ph .product-card__number {
    display: block;
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    font-variant-numeric: tabular-nums;
    color: var(--bn-brass-ink);
    margin-bottom: var(--bn-space-3xs);
  }

  .bn-fc .bn-fc__ph .product-card__brand {
    display: block;
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    color: var(--bn-text-on-bone-dim);
    margin-bottom: var(--bn-space-3xs);
  }

  .bn-fc .bn-fc__ph .product-card__title {
    margin: 0 0 var(--bn-space-2xs);
    font-family: var(--bn-font-accent);
    font-style: italic;
    font-weight: 400;
    font-size: var(--bn-text-lg);
    line-height: var(--bn-leading-title);
    letter-spacing: var(--bn-track-title);
    color: var(--bn-text-on-bone);
  }

  .bn-fc .bn-fc__ph .product-card__notes {
    margin: 0 0 var(--bn-space-sm);
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-xs);
    line-height: 1.45;
    color: var(--bn-text-on-bone-dim);
  }

  .bn-fc .bn-fc__ph .product-card__footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin-top: auto;
    padding-top: var(--bn-space-2xs);
    border-top: 1px solid var(--bn-line-on-bone);
  }

  .bn-fc .bn-fc__ph .product-card__price {
    font-family: var(--bn-font-display);
    font-variation-settings: var(--bn-display-vf);
    font-weight: var(--bn-weight-strong);
    font-size: var(--bn-text-md);
    letter-spacing: var(--bn-track-title);
    font-variant-numeric: tabular-nums;
    color: var(--bn-text-on-bone);
  }

  .bn-fc .bn-fc__ph .product-card__plan-label {
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    color: var(--bn-text-on-bone-dim);
  }

  .bn-fc .bn-fc__ph .product-card__add-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--bn-space-2xs);
    width: 100%;
    padding: var(--bn-space-sm);
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    color: var(--bn-text-on-ink);
    background: var(--bn-ink);
    border: 0;
    border-radius: var(--bn-radius-sm);
    cursor: pointer;
    transition: background var(--bn-dur-fast) var(--bn-ease);
  }

  .bn-fc .bn-fc__ph .product-card__add-btn:hover {
    background: var(--bn-forest);
  }

  .bn-fc .bn-fc__ph .product-card__add-btn svg {
    width: 14px;
    height: 14px;
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "The Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "10 Exclusive Fragrances"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent line (rendered in italic serif on its own line)",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Curated from the world's most prestigious perfume houses. Each scent tells a story of luxury and craftsmanship."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
