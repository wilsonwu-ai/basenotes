<footer class="footer bn-on-ink">
  {% comment %} Newsletter Section {% endcomment %}
  {%- if section.settings.newsletter_enabled -%}
  <div class="footer__newsletter bn-on-forest">
    <div class="container">
      <div class="footer__newsletter-inner">
        <div class="footer__newsletter-content">
          <p class="footer__newsletter-eyebrow">Newsletter</p>
          <h3 class="footer__newsletter-title">{{ section.settings.newsletter_heading | default: 'Join the Inner Circle' }}</h3>
          <p class="footer__newsletter-text">{{ section.settings.newsletter_description | default: 'Subscribe for exclusive offers, fragrance tips, and early access to new releases.' }}</p>
        </div>
        <div class="footer__newsletter-form">
          {%- form 'customer', class: 'footer__newsletter-form-inner' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,footer">
            <div class="footer__newsletter-input-wrapper">
              <input
                type="email"
                name="contact[email]"
                class="footer__newsletter-input"
                placeholder="Enter your email"
                required
                autocomplete="email"
              >
              <button type="submit" class="footer__newsletter-btn btn btn--primary">
                Subscribe
              </button>
            </div>
            <p class="footer__newsletter-privacy">We respect your privacy. Unsubscribe anytime.</p>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
  {%- endif -%}

  {% comment %} Main Footer {% endcomment %}
  <div class="footer__main">
    <div class="container">
      <div class="footer__grid" data-reveal-group>
        {% comment %} Brand Column {% endcomment %}
        <div class="footer__brand" data-reveal>
          <div class="footer__logo">
            {%- if section.settings.logo != blank -%}
              <a href="{{ routes.root_url }}">
                <img
                  src="{{ section.settings.logo | image_url: width: 200 }}"
                  alt="{{ shop.name }}"
                  loading="lazy"
                  width="{{ section.settings.logo.width }}"
                  height="{{ section.settings.logo.height }}"
                >
              </a>
            {%- else -%}
              <a href="{{ routes.root_url }}" class="footer__logo-text">{{ shop.name }}</a>
            {%- endif -%}
          </div>
          <p class="footer__tagline">{{ section.settings.tagline | default: "Curating the world's most exclusive fragrances for the discerning collector." }}</p>

          {% comment %} Contact Info {% endcomment %}
          {%- if section.settings.show_contact -%}
          <div class="footer__contact">
            <p class="footer__label">Contact</p>
            {%- if section.settings.email != blank -%}
            <a href="mailto:{{ section.settings.email }}" class="footer__contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="2" y="4" width="20" height="16" rx="2"/>
                <path d="m22 6-10 7L2 6"/>
              </svg>
              {{ section.settings.email }}
            </a>
            {%- endif -%}
            {%- if section.settings.phone != blank -%}
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '-', '' }}" class="footer__contact-item">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              {{ section.settings.phone }}
            </a>
            {%- endif -%}
          </div>
          {%- endif -%}

          {% comment %} Social Links {% endcomment %}
          {%- if section.settings.show_social -%}
          <div class="footer__social">
            {%- if settings.social_instagram != blank -%}
              <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="footer__social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <rect x="2" y="2" width="20" height="20" rx="5"/>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_tiktok != blank -%}
              <a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="footer__social-link">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_facebook != blank -%}
              <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="footer__social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_youtube != blank -%}
              <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="footer__social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/>
                </svg>
              </a>
            {%- endif -%}
            {%- if settings.social_pinterest != blank -%}
              <a href="{{ settings.social_pinterest }}" target="_blank" rel="noopener noreferrer" aria-label="Pinterest" class="footer__social-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="12" cy="12" r="10"/>
                  <path d="M8 12c0-2.2 1.8-4 4-4s4 1.8 4 4-1.8 4-4 4"/>
                  <path d="M8 16l2-6"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
          {%- endif -%}
        </div>

        {% comment %} Menu Columns {% endcomment %}
        <div class="footer__columns">
          {%- for block in section.blocks -%}
            <div class="footer__column" data-reveal {{ block.shopify_attributes }}>
              <h4 class="footer__heading">{{ block.settings.heading }}</h4>
              <ul class="footer__list">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="footer__link">{{ link.title }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {% comment %} Giant wordmark {% endcomment %}
  <div class="footer__mark">
    <div class="container">
      <a href="{{ routes.root_url }}" class="footer__mark-word" data-reveal>{{ shop.name }}</a>
    </div>
  </div>

  {% comment %} Bottom Bar {% endcomment %}
  <div class="footer__bottom">
    <div class="container">
      <div class="footer__bottom-inner">
        <div class="footer__copyright">
          <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
        </div>

        <div class="footer__legal">
          <a href="{{ section.settings.privacy_link | default: policies.privacy_policy.url }}">Privacy Policy</a>
          <a href="{{ section.settings.terms_link | default: policies.terms_of_service.url }}">Terms of Service</a>
          <a href="{{ section.settings.refund_link | default: policies.refund_policy.url }}">Refund Policy</a>
          <a href="{{ section.settings.shipping_link | default: policies.shipping_policy.url }}">Shipping Policy</a>
          <a href="/policies/refund-policy">Cancellations</a>
        </div>

        {% comment %} Payment Icons {% endcomment %}
        {%- if section.settings.show_payment_icons -%}
        <div class="footer__payments">
          <span class="footer__payments-label">Secure payments</span>
          <div class="footer__payments-icons">
            {%- for type in shop.enabled_payment_types -%}
              {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

<style>
  /* ==========================================================================
     BASE NOTE — Footer, Direction A "Editorial Grotesque"
     Forest newsletter band · ink body · giant Bricolage wordmark.
     Surface classes (.bn-on-ink / .bn-on-forest) come from bn-tokens.css and
     supply --bn-text-muted, --bn-line and --bn-metal-text at legal contrast.
     ========================================================================== */

  .footer {
    /* .bn-on-ink already sets background + colour + the three surface vars. */
    font-family: var(--bn-font-body);
  }

  .footer .container {
    max-width: var(--bn-container);
    padding-left: var(--bn-gutter);
    padding-right: var(--bn-gutter);
  }

  /* Small-caps utility label — the footer's only repeating micro-type. */
  .footer__label,
  .footer__heading,
  .footer__newsletter-eyebrow,
  .footer__payments-label {
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-2xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    line-height: 1;
  }

  /* ── Newsletter band ────────────────────────────────────────────────── */
  .footer__newsletter {
    padding: var(--bn-space-2xl) 0;
    border-bottom: 1px solid var(--bn-hairline);
  }

  .footer__newsletter-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--bn-space-xl);
    align-items: end;
  }

  @media (max-width: 900px) {
    .footer__newsletter-inner {
      grid-template-columns: 1fr;
      text-align: left;
      gap: var(--bn-space-lg);
    }
  }

  /* Bone, not brass: brass clears 4.5:1 on ink but only just on forest, so on
     this band the metal is the rule and the text stays bone. */
  .footer__newsletter-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--bn-space-2xs);
    color: var(--bn-text-on-ink);
    margin: 0 0 var(--bn-space-sm);
  }

  .footer__newsletter-eyebrow::before {
    content: '';
    width: 26px;
    height: 1px;
    flex: none;
    background: var(--bn-brass);
  }

  .footer__newsletter-title {
    font-family: var(--bn-font-display);
    font-variation-settings: var(--bn-display-vf);
    font-weight: var(--bn-weight-display);
    font-size: var(--bn-text-2xl);
    line-height: var(--bn-leading-title);
    letter-spacing: var(--bn-track-display);
    color: inherit;
    margin: 0 0 var(--bn-space-2xs);
    max-width: 16ch;
  }

  .footer__newsletter-text {
    color: var(--bn-text-muted);
    margin: 0;
    font-size: var(--bn-text-sm);
    line-height: var(--bn-leading-body);
    max-width: 44ch;
  }

  .footer__newsletter-input-wrapper {
    display: flex;
    gap: var(--bn-space-2xs);
  }

  @media (max-width: 576px) {
    .footer__newsletter-input-wrapper {
      flex-direction: column;
    }
  }

  .footer__newsletter .footer__newsletter-input {
    flex: 1;
    min-width: 0;
    padding: var(--bn-space-xs) 0;
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-base);
    color: var(--bn-text-on-ink);
    border: none;
    border-bottom: 1px solid var(--bn-line);
    border-radius: var(--bn-radius-none);
    background: transparent;
    transition: border-color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__newsletter .footer__newsletter-input::placeholder {
    color: var(--bn-text-muted);
  }

  .footer__newsletter .footer__newsletter-input:focus {
    outline: none;
    box-shadow: none;
    border-bottom-color: var(--bn-brass);
  }

  .footer__newsletter .footer__newsletter-btn {
    flex: none;
    background: var(--bn-bone);
    color: var(--bn-ink);
    border: 1px solid var(--bn-bone);
    border-radius: var(--bn-radius-sm);
    padding: var(--bn-space-xs) var(--bn-space-md);
    font-family: var(--bn-font-body);
    font-size: var(--bn-text-xs);
    font-weight: var(--bn-weight-strong);
    letter-spacing: var(--bn-track-label);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background var(--bn-dur-fast) var(--bn-ease),
                border-color var(--bn-dur-fast) var(--bn-ease),
                color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__newsletter .footer__newsletter-btn:hover {
    background: var(--bn-brass);
    border-color: var(--bn-brass);
    color: var(--bn-ink);
  }

  .footer__newsletter-privacy {
    font-size: var(--bn-text-2xs);
    letter-spacing: var(--bn-track-nav);
    text-transform: uppercase;
    color: var(--bn-text-muted);
    margin: var(--bn-space-xs) 0 0;
  }

  /* ── Main footer — brand column + three menu columns ────────────────── */
  .footer__main {
    padding: var(--bn-space-2xl) 0 var(--bn-space-xl);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--bn-space-xl) var(--bn-space-2xl);
    align-items: start;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--bn-space-lg) var(--bn-space-md);
  }

  @media (max-width: 900px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Brand Column */
  .footer__logo {
    margin-bottom: var(--bn-space-md);
  }

  .footer__logo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 130px;
  }

  .footer__logo-text {
    display: block;
    font-family: var(--bn-font-display);
    font-variation-settings: 'wdth' 100, 'opsz' 24;
    font-size: var(--bn-text-sm);
    font-weight: var(--bn-weight-strong);
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
  }

  .footer__tagline {
    font-size: var(--bn-text-sm);
    color: var(--bn-text-muted);
    line-height: var(--bn-leading-body);
    margin: 0 0 var(--bn-space-md);
    max-width: 34ch;
  }

  /* Contact Info */
  .footer__contact {
    margin-bottom: var(--bn-space-md);
  }

  .footer__label {
    color: var(--bn-metal-text);
    margin: 0 0 var(--bn-space-2xs);
  }

  .footer__contact-item {
    display: flex;
    align-items: center;
    gap: var(--bn-space-2xs);
    font-size: var(--bn-text-sm);
    color: var(--bn-text-muted);
    text-decoration: none;
    margin-bottom: var(--bn-space-3xs);
    transition: color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__contact-item:hover {
    color: var(--bn-text-on-ink);
  }

  .footer__contact-item svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  /* Social Links */
  .footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bn-space-2xs);
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: transparent;
    border: 1px solid var(--bn-line);
    border-radius: var(--bn-radius-sm);
    color: var(--bn-text-on-ink);
    transition: background var(--bn-dur-fast) var(--bn-ease),
                color var(--bn-dur-fast) var(--bn-ease),
                border-color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__social-link:hover {
    background: var(--bn-bone);
    border-color: var(--bn-bone);
    color: var(--bn-ink);
  }

  .footer__social-link svg {
    width: 17px;
    height: 17px;
  }

  /* Menu Columns */
  .footer__column {
    min-width: 0;
  }

  .footer__heading {
    color: var(--bn-metal-text);
    margin: 0 0 var(--bn-space-sm);
    padding-bottom: var(--bn-space-2xs);
    border-bottom: 1px solid var(--bn-line);
  }

  .footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer__list li {
    margin-bottom: var(--bn-space-3xs);
  }

  .footer__link {
    display: inline-block;
    padding: var(--bn-space-3xs) 0;
    font-size: var(--bn-text-sm);
    color: var(--bn-text-muted);
    text-decoration: none;
    transition: color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__link:hover {
    color: var(--bn-text-on-ink);
  }

  /* ── Giant wordmark ─────────────────────────────────────────────────── */
  .footer__mark {
    padding: var(--bn-space-md) 0 0;
    overflow: hidden;
  }

  .footer__mark-word {
    display: block;
    font-family: var(--bn-font-display);
    font-variation-settings: var(--bn-display-vf);
    font-weight: var(--bn-weight-display);
    /* 31vw sets the wordmark to run the full gutter-to-gutter measure for a
       nine-character shop name; overflow:hidden on the parent is the backstop
       for longer names. */
    font-size: clamp(2.5rem, 31vw, 26rem);
    line-height: 0.82;
    letter-spacing: var(--bn-track-display);
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    /* Clipped at the baseline against the bottom-bar rule — deliberate. */
    margin-bottom: calc(var(--bn-space-2xs) * -1);
    transition: color var(--bn-dur-base) var(--bn-ease);
  }

  .footer__mark-word:hover {
    color: var(--bn-brass);
  }

  /* ── Bottom Bar ─────────────────────────────────────────────────────── */
  .footer__bottom {
    border-top: 1px solid var(--bn-line);
    padding: var(--bn-space-md) 0 var(--bn-space-lg);
  }

  .footer__bottom-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--bn-space-sm) var(--bn-space-lg);
  }

  @media (max-width: 768px) {
    .footer__bottom-inner {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }
  }

  .footer__copyright p {
    font-size: var(--bn-text-2xs);
    letter-spacing: var(--bn-track-nav);
    text-transform: uppercase;
    color: var(--bn-text-muted);
    margin: 0;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bn-space-2xs) var(--bn-space-md);
    justify-content: flex-start;
  }

  .footer__legal a {
    font-size: var(--bn-text-2xs);
    letter-spacing: var(--bn-track-nav);
    text-transform: uppercase;
    color: var(--bn-text-muted);
    text-decoration: none;
    transition: color var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__legal a:hover {
    color: var(--bn-text-on-ink);
  }

  /* Payment Icons */
  .footer__payments {
    display: flex;
    align-items: center;
    gap: var(--bn-space-2xs);
  }

  @media (max-width: 768px) {
    .footer__payments {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--bn-space-2xs);
    }
  }

  .footer__payments-label {
    color: var(--bn-text-muted);
    white-space: nowrap;
  }

  .footer__payments-icons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--bn-space-3xs);
    justify-content: flex-start;
  }

  .footer__payment-icon {
    height: 22px;
    width: auto;
    opacity: 0.65;
    transition: opacity var(--bn-dur-fast) var(--bn-ease);
  }

  .footer__payment-icon:hover {
    opacity: 1;
  }

  /* ── Back-to-top (created by the script below) ──────────────────────── */
  .footer__back-to-top {
    position: fixed;
    bottom: var(--bn-space-md);
    right: var(--bn-space-md);
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bn-ink);
    color: var(--bn-bone);
    border: 1px solid var(--bn-brass);
    border-radius: var(--bn-radius-sm);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, var(--bn-reveal-distance), 0);
    transition: opacity var(--bn-dur-fast) var(--bn-ease),
                visibility var(--bn-dur-fast) var(--bn-ease),
                transform var(--bn-dur-fast) var(--bn-ease),
                background var(--bn-dur-fast) var(--bn-ease),
                color var(--bn-dur-fast) var(--bn-ease);
    z-index: var(--bn-z-sticky);
    box-shadow: var(--bn-shadow-lift);
  }

  .footer__back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .footer__back-to-top:hover {
    background: var(--bn-brass);
    color: var(--bn-ink);
  }

  .footer__back-to-top svg {
    width: 20px;
    height: 20px;
  }
</style>

<script>
  (function() {
    // Back to top functionality
    const backToTop = document.createElement('button');
    backToTop.className = 'footer__back-to-top';
    backToTop.setAttribute('aria-label', 'Back to top');
    backToTop.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="18 15 12 9 6 15"/></svg>';
    document.body.appendChild(backToTop);

    function toggleBackToTop() {
      if (window.pageYOffset > 400) {
        backToTop.classList.add('is-visible');
      } else {
        backToTop.classList.remove('is-visible');
      }
    }

    window.addEventListener('scroll', toggleBackToTop);

    backToTop.addEventListener('click', function() {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  })();
</script>

