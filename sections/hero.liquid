{%- liquid
  assign has_media = false
  assign hero_bg_asset = 'hero-background.jpg' | asset_url
  if section.settings.video != blank or section.settings.image != blank or section.settings.image_url != blank or hero_bg_asset != blank
    assign has_media = true
  endif
-%}

<section class="hero{% unless has_media %} hero--minimal{% endunless %}" id="top">
  {%- if has_media -%}
    <div class="hero__background">
      {%- if section.settings.video != blank -%}
        <video autoplay muted loop playsinline>
          <source src="{{ section.settings.video }}" type="video/mp4">
        </video>
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          srcset="{{ section.settings.image | image_url: width: 750 }} 750w,
                  {{ section.settings.image | image_url: width: 1080 }} 1080w,
                  {{ section.settings.image | image_url: width: 1920 }} 1920w"
          sizes="100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading }}"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- elsif section.settings.image_url != blank -%}
        <img
          src="{{ section.settings.image_url }}"
          alt="{{ section.settings.heading }}"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- else -%}
        <img
          src="{{ 'hero-atomizer.png' | asset_url }}"
          alt="{{ section.settings.heading }}"
          width="1920"
          height="1080"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        >
      {%- endif -%}
      <div class="hero__overlay"></div>
    </div>
  {%- endif -%}

  <div class="hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="hero__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.description != blank -%}
      <p class="hero__description">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--gold btn--large">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.secondary_button_label != blank -%}
        <a href="{{ section.settings.secondary_button_link }}" class="btn btn--outline-light btn--large">
          {{ section.settings.secondary_button_label }}
        </a>
      {%- endif -%}
    </div>

    <ul class="hero__proof" role="list" aria-label="Why shop Base Note">
      <li>{{ section.settings.proof_one }}</li>
      <li>{{ section.settings.proof_two }}</li>
      <li>{{ section.settings.proof_three }}</li>
    </ul>

    {%- unless has_media -%}
      <div class="hero__accent">
        <span class="hero__price">$20<span>/month</span></span>
        <span class="hero__price-note">Premium 5ml atomizers · Free shipping · Cancel anytime</span>
      </div>
    {%- endunless -%}
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh; /* Dynamic viewport height for mobile */
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    background: var(--color-primary);
    padding-top: calc(var(--header-height) + 40px); /* Account for header + announcement bar */
  }

  /* Compact minimal hero without background media */
  .hero--minimal {
    min-height: auto;
    padding: calc(var(--header-height) + 50px) var(--spacing-xl) 3rem; /* Extra space for announcement bar */
    background: linear-gradient(135deg, #2D4641 0%, #1a2927 100%);
  }

  .hero__background {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__background img,
  .hero__background video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(15, 18, 17, 0.92) 0%, rgba(15, 18, 17, 0.76) 42%, rgba(15, 18, 17, 0.18) 100%);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    width: 100%;
    min-width: 0;
    width: min(100% - 2rem, var(--container-max-width));
    margin-inline: auto;
    text-align: start;
    color: white;
    max-width: none;
    padding-inline: clamp(1rem, 3vw, 2.75rem);
  }

  .hero--minimal .hero__content {
    padding: var(--spacing-lg) var(--spacing-xl);
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: #C9A962;
    margin-bottom: var(--spacing-lg);
    padding-block-end: 0.55rem;
    border-block-end: 1px solid #C9A962;
  }

  .hero__title {
    max-width: 10ch;
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    font-size: clamp(3rem, 7vw, 6.75rem);
    font-weight: 500;
    line-height: 0.94;
    margin-bottom: var(--spacing-lg);
    letter-spacing: -0.035em;
    overflow-wrap: break-word;
  }

  .hero--minimal .hero__title {
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .hero__description {
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.7;
    opacity: 0.85;
    max-width: 36rem;
    margin: 0 0 var(--spacing-xl);
    color: rgba(255, 255, 255, 0.9);
  }

  .hero__cta {
    display: flex;
    width: 100%;
    min-width: 0;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: flex-start;
  }

  .hero__proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: clamp(2rem, 5vw, 4rem) 0 0;
    padding: 1rem 0 0;
    border-block-start: 1px solid rgba(255, 255, 255, 0.22);
    list-style: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.84);
  }

  .hero__proof li {
    display: flex;
    gap: 0.65rem;
    align-items: center;
  }

  .hero__proof li::before {
    width: 1.1rem;
    height: 1px;
    content: '';
    background: var(--color-secondary);
  }

  /* Price accent for minimal hero */
  .hero__accent {
    margin-top: var(--spacing-2xl);
    padding-top: var(--spacing-xl);
    border-top: 1px solid rgba(201, 169, 98, 0.3);
  }

  .hero__price {
    display: block;
    font-family: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
    font-size: 2.5rem;
    font-weight: 600;
    color: #C9A962;
    margin-bottom: var(--spacing-sm);
  }

  .hero__price span {
    font-size: 1.25rem;
    font-weight: 400;
    opacity: 0.8;
  }

  .hero__price-note {
    display: block;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    /* MOBILE_OVERFLOW_GUARD_START: constrain intrinsic text/button widths, not the page. */
    .hero:not(.hero--minimal) {
      min-height: 82dvh;
    }

    .hero--minimal {
      padding: calc(var(--header-height) + 1rem) var(--spacing-md) 2rem;
    }

    .hero__content,
    .hero--minimal .hero__content {
      padding-inline: var(--spacing-md);
    }

    .hero__overlay {
      background: linear-gradient(180deg, rgba(15, 18, 17, 0.36) 0%, rgba(15, 18, 17, 0.88) 58%, rgba(15, 18, 17, 0.96) 100%);
    }

    .hero__title {
      max-width: 9ch;
      font-size: clamp(3rem, 15vw, 4.5rem);
    }

    .hero__cta {
      flex-direction: column;
      align-items: stretch;
    }

    .hero__cta .btn {
      width: min(100%, 300px);
      max-width: 300px;
      min-width: 0;
      padding-inline: var(--spacing-lg);
      overflow-wrap: anywhere;
      text-align: center;
      white-space: normal;
    }

    .hero__price {
      font-size: 2rem;
    }

    .hero__proof {
      display: grid;
      gap: 0.75rem;
    }
    /* MOBILE_OVERFLOW_GUARD_END */
  }
</style>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (upload)"
    },
    {
      "type": "text",
      "id": "image_url",
      "label": "Background image URL (external)",
      "info": "Use an external image URL (e.g., from Unsplash). This is used if no image is uploaded above."
    },
    {
      "type": "url",
      "id": "video",
      "label": "Background video URL (MP4)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Exclusive Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find My Scent"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Experience rare, high-end fragrances from the world's most exclusive houses. Delivered monthly to your door."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button label",
      "default": "View the Scent Vault"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Take The Quiz"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    },
    {
      "type": "text",
      "id": "proof_one",
      "label": "Proof point one",
      "default": "Authentic fragrance"
    },
    {
      "type": "text",
      "id": "proof_two",
      "label": "Proof point two",
      "default": "5 ml · about 60 sprays"
    },
    {
      "type": "text",
      "id": "proof_three",
      "label": "Proof point three",
      "default": "One-time or monthly"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
