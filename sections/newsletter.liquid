<section class="section section--dark newsletter-section" id="newsletter" aria-labelledby="NewsletterTitle-{{ section.id }}">
  <div class="container">
    <div class="newsletter">
      <p class="newsletter__eyebrow">New scent drops</p>
      <h2 class="newsletter__title" id="NewsletterTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
      <p class="newsletter__description">{{ section.settings.description }}</p>

      {%- form 'customer', class: 'newsletter__form', id: 'newsletter-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="newsletter__field">
          <label for="newsletter-email" class="newsletter__label">{{ section.settings.field_label }}</label>
          <input
            type="email"
            name="contact[email]"
            id="newsletter-email"
            class="newsletter__input"
            placeholder="{{ section.settings.placeholder }}"
            required
            aria-required="true"
            autocomplete="email"
            aria-describedby="NewsletterNote-{{ section.id }}"
          >
        </div>
        <button type="submit" class="btn btn--gold newsletter__button">
          {{ section.settings.button_label }}
        </button>
      {%- endform -%}

      {%- if form.posted_successfully? -%}
        <div class="newsletter__message newsletter__message--success" role="status" aria-live="polite">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span>Thanks for subscribing! Check your inbox for a welcome message.</span>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <div class="newsletter__message newsletter__message--error" role="alert">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
          <span>{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</span>
        </div>
      {%- endif -%}

      {%- if section.settings.privacy_note != blank -%}
        <p class="newsletter__note" id="NewsletterNote-{{ section.id }}">
          {{ section.settings.privacy_note }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding: clamp(4rem, 9vw, 8rem) 0;
    background: #1f3a34;
  }

  .newsletter {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter__title {
    max-width: 14ch;
    margin-inline: auto;
    font-size: clamp(2.75rem, 6vw, 5.5rem);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.035em;
    margin-bottom: var(--spacing-md);
    text-wrap: balance;
  }

  .newsletter__eyebrow {
    margin-block-end: var(--spacing-lg);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #d8bd82;
  }

  .newsletter__description {
    color: rgba(255, 255, 255, 0.7);
    font-size: var(--font-size-lg);
    margin-bottom: var(--spacing-xl);
  }

  .newsletter__form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--spacing-sm);
    max-width: 620px;
    margin: 0 auto;
    align-items: end;
    text-align: start;
  }

  .newsletter__field {
    min-width: 0;
  }

  .newsletter__label {
    display: block;
    margin-block-end: var(--spacing-sm);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .newsletter__input {
    flex: 1;
    padding: 1rem 1.25rem;
    font-family: var(--font-body);
    font-size: var(--font-size-base);
    color: var(--color-text);
    background: white;
    border: 2px solid transparent;
    width: 100%;
    min-height: 54px;
    border-radius: 0;
    transition: border-color 0.2s;
  }

  .newsletter__input:focus-visible {
    outline: 3px solid #d8bd82;
    outline-offset: 3px;
  }

  .newsletter__button {
    min-height: 54px;
    border-radius: 0;
  }

  .newsletter__input::placeholder {
    color: var(--color-text-muted);
  }

  .newsletter__note {
    margin-top: var(--spacing-lg);
    font-size: var(--font-size-xs);
    opacity: 0.5;
  }

  .newsletter__message {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-sm);
    margin-top: var(--spacing-lg);
    padding: var(--spacing-md) var(--spacing-lg);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
  }

  .newsletter__message svg {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .newsletter__message--success {
    background: rgba(76, 175, 80, 0.2);
    color: #4caf50;
  }

  .newsletter__message--error {
    background: rgba(244, 67, 54, 0.2);
    color: #f44336;
  }

  @media (max-width: 576px) {
    .newsletter__form {
      grid-template-columns: 1fr;
    }

    .newsletter__form .btn {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "class": "newsletter-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Inner Circle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Be the first to discover new arrivals, exclusive offers, and insider access to the world of luxury fragrance."
    },
    {
      "type": "text",
      "id": "field_label",
      "label": "Email field label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy note",
      "default": "We respect your privacy. Unsubscribe at any time."
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
