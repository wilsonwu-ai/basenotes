{{ 'scent-storefront.css' | asset_url | stylesheet_tag }}
{%- assign rotation_collection = collections.fragrances -%}
{%- assign rotation_first = rotation_collection.products | first -%}
{%- assign rotation_variant = rotation_first.variants | first -%}
{%- assign rotation_plan = rotation_variant.selling_plan_allocations | first -%}
{%- assign rotation_renewal = rotation_plan.price_adjustments.last.price | default: rotation_variant.price -%}
<section class="scent-route" aria-labelledby="MonthlyRotationTitle">
  <header class="scent-route__intro"><p class="scent-eyebrow">02 / Keep discovering</p><h1 id="MonthlyRotationTitle">Your Monthly Rotation.</h1><p>A fragrance subscription for a nose that likes to wander. One authentic 5ml fragrance vial, delivered monthly. Choose your first scent below.</p>{% if rotation_plan %}<p>{{ rotation_plan.price | money }} for your first shipment, then {{ rotation_renewal | money }} per month. Shipping and taxes, if applicable, are shown at checkout.</p>{% endif %}<a class="scent-button" href="#RotationScents">Choose your first scent <span aria-hidden="true">↓</span></a></header>
  <div class="scent-route__content"><div class="scent-route__steps"><article><p class="scent-eyebrow">01 / Choose</p><h2>Start with a scent.</h2><p>Find a fragrance below, select Monthly Rotation on its product page, and review the recurring terms.</p></article><article><p class="scent-eyebrow">02 / Make it yours</p><h2>A little discovery.</h2><p>Your 5ml glass atomizer gives you time to experience the fragrance on your skin, in your life.</p></article><article><p class="scent-eyebrow">03 / Stay in control</p><h2>Keep your options open.</h2><p>Manage your scent, pause, or cancel through your subscription account. Changes must be made before the next renewal is processed.</p></article></div>
    <p>Prefer to order whenever you like? <a href="/collections/fragrances"><u>Shop one-time vials instead</u></a>. No subscription is required.</p>
    <div id="RotationScents" class="scent-grid">{%- for product in rotation_collection.products limit: 12 -%}{%- assign variant = product.variants | first -%}{%- assign allocation = variant.selling_plan_allocations | first -%}{%- if allocation and variant.available -%}<article class="scent-card"><a class="scent-card__media" href="{{ product.url }}?purchase=subscription#monthly-rotation"><span class="scent-card__vial">{% render 'vial-illustration', product: product %}</span></a><p class="scent-card__brand">{{ product.vendor }}</p><h2><a href="{{ product.url }}?purchase=subscription#monthly-rotation">{{ product.title | remove_first: product.vendor | strip }}</a></h2><p class="scent-card__format">{{ allocation.price | money }} first shipment, then {{ variant.price | money }}/month</p><a class="scent-button" href="{{ product.url }}?purchase=subscription#monthly-rotation">Choose this scent ↗</a></article>{%- endif -%}{%- endfor -%}</div>
    <p style="margin-top:2.5rem;font-size:.85rem">Monthly Rotation is an automatically renewing subscription. By selecting it and accepting its terms, you authorize recurring charges until canceled. The product page and checkout show the specific plan, price, and renewal details. <a href="/pages/faq"><u>Read subscription FAQs</u></a>.</p>
  </div>
</section>
{% schema %}{"name":"Monthly Rotation","settings":[]}{% endschema %}
