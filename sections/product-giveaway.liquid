{%- comment -%}
  All Liquid-to-JS interpolation is confined to this JSON island and every value
  goes through `| json`. The behaviour script below contains zero Liquid, which
  is what lets it be lifted out verbatim and checked with `node --check`.
{%- endcomment -%}
<script type="application/json" id="bnGiveData">
  {
    "variantId": {{ current_variant.id | json }},
    "claimLabel": {{ claim_label | json }},
    "stickyLabel": {{ claim_label_short | json }},
    "busyLabel": {{ 'Adding…' | json }},
    "doneLabel": {{ 'Added to your cart' | json }},
    "doneStatus": {{ 'In your cart. Checkout takes about a minute.' | json }},
    "errorStatus": {{ 'That did not go through. Please try again, or refresh the page.' | json }},
    "cartUrl": {{ routes.cart_url | default: '/cart' | json }},

    "subTerms": {{ 'first month ' | append: sub_first_price | append: ', then ' | append: sub_price | json }},
    "subAdding": {{ 'Adding your subscription…' | json }},
    "subAdded": {{ 'Added — ' | json }},
    "subError": {{ "Couldn't add the subscription — try again" | json }},
    "fineprint": {{ fineprint | json }},
    "fineprintSub": {{ fineprint_sub | json }}
  }
</script>

<script>
  (function () {
    'use strict';

    var root = document.getElementById('bnGiveRoot');
    if (!root) { return; }

    var dataEl = document.getElementById('bnGiveData');
    var DATA = {};
    if (dataEl) {
      try {
        DATA = JSON.parse(dataEl.textContent || dataEl.innerHTML || '{}');
      } catch (e) {
        DATA = {};
      }
    }

    var form = document.getElementById('bnGiveForm');
    var btn = document.getElementById('bnGiveBtn');
    var btnLabel = document.getElementById('bnGiveBtnLabel');
    var status = document.getElementById('bnGiveStatus');
    var sticky = document.getElementById('bnGiveSticky');
    var stickyBtn = document.getElementById('bnGiveStickyBtn');
    var stickyLabel = document.getElementById('bnGiveStickyLabel');
    var choice = document.getElementById('bnGiveChoice');
    var busy = false;

    function setLabels(main, small) {
      if (btnLabel) { btnLabel.textContent = main; }
      if (stickyLabel) { stickyLabel.textContent = small; }
    }

    function setStatus(text, isError) {
      if (!status) { return; }
      status.textContent = text || '';
      if (isError) {
        status.className = 'bn-give__status is-error';
      } else {
        status.className = 'bn-give__status';
      }
    }

    function setBusy(on) {
      busy = on;
      if (btn) {
        btn.disabled = on;
        if (on) {
          btn.className = btn.className + ' is-busy';
        } else {
          btn.className = btn.className.replace(/\s*is-busy/g, '');
        }
      }
      if (stickyBtn) { stickyBtn.disabled = on; }
    }

    function resetLabels() {
      setLabels(DATA.claimLabel || 'Claim my free 5ml', DATA.stickyLabel || 'Claim my free 5ml');
    }

    // Terminal state after a successful claim. Kept separate from setBusy() because busy is
    // transient and reversible, whereas this must survive for the life of the page view.
    var claimed = false;

    function lockClaim() {
      claimed = true;
      busy = false;
      if (btn) {
        btn.disabled = true;
        btn.className = btn.className.replace(/\s*is-busy/g, '') + ' is-claimed';
      }
      if (stickyBtn) { stickyBtn.disabled = true; }
    }

    function claim() {
      // One bottle per person is a disclosed condition of the offer, not a preference.
      if (claimed) { return; }
      if (busy) { return; }
      if (!DATA.variantId) {
        if (form) { form.submit(); }
        return;
      }

      setBusy(true);
      setLabels(DATA.busyLabel || 'Adding…', DATA.busyLabel || 'Adding…');
      setStatus('');

      window.fetch('/cart/add.js', {
        method: 'POST',
        credentials: 'same-origin',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: DATA.variantId,
          quantity: 1,
          properties: { '_bn_offer': 'free-5ml' }
        })
      })
        .then(function (response) {
          return response.json().then(function (payload) {
            if (!response.ok) {
              throw new Error((payload && payload.description) || 'add_failed');
            }
            return payload;
          });
        })
        .then(function () {
          // PRD-Aug08: do NOT reset the label and re-enable. /cart/add.js MERGES a matching line and
          // ADDS the quantity, so a second press silently makes it 2 bottles — against a page that
          // states "one per customer" as a binding FTC condition and a batch of 40. The button goes
          // to a terminal state and stays there; reloading the page re-renders it from real cart
          // contents via the server-side already-claimed guard.
          claimed = true;
          setLabels(DATA.doneLabel || 'Added to your cart', DATA.doneLabel || 'Added');
          setStatus(DATA.doneStatus || '', false);
          lockClaim();

          if (typeof window.refreshAndOpenCartDrawer === 'function') {
            window.refreshAndOpenCartDrawer();
          } else if (typeof window.openCartDrawer === 'function') {
            window.openCartDrawer();
          } else {
            window.location.href = DATA.cartUrl || '/cart';
          }
        })
        .catch(function (error) {
          // If the add already succeeded and something downstream threw (e.g. the drawer helper),
          // do NOT re-enable — the bottle is in the cart and re-enabling would invite a second one.
          if (claimed) { return; }
          setBusy(false);
          resetLabels();
          setStatus((error && error.message) || DATA.errorStatus || 'Please try again.', true);
        });
    }

    if (form) {
      form.addEventListener('submit', function (event) {
        // No fetch (very old browser): let the native product form post to /cart/add
        // and land the visitor on the cart page. Never leave a dead button.
        if (typeof window.fetch !== 'function') { return; }
        event.preventDefault();
        claim();
      });
    }

    if (stickyBtn) {
      stickyBtn.addEventListener('click', function (event) {
        event.preventDefault();
        if (typeof window.fetch !== 'function') {
          if (form) { form.submit(); }
          return;
        }
        claim();
      });
    }

    // Sticky bar: reveal only once the whole choice block has scrolled ABOVE the
    // viewport, so it can never cover the buttons it duplicates.
    if (sticky && choice && typeof window.IntersectionObserver !== 'undefined') {
      var show = function () {
        sticky.hidden = false;
        sticky.className = 'bn-give-sticky is-visible';
      };
      var hide = function () {
        sticky.className = 'bn-give-sticky';
        sticky.hidden = true;
      };

      var observer = new window.IntersectionObserver(function (entries) {
        var i;
        for (i = 0; i < entries.length; i++) {
          var entry = entries[i];
          if (!entry.isIntersecting && entry.boundingClientRect.top < 0) {
            show();
          } else {
            hide();
          }
        }
      }, { threshold: 0 });

      observer.observe(choice);
    }
  })();
</script>


{%- comment -%}
  Subscribe & Save + picker behaviour. Same rules as the script above: ES5 only,
  no libraries, and ZERO Liquid inside the function body so it can be lifted out
  verbatim and checked with `node --check`. Everything it needs comes from the
  #bnGiveData island.
{%- endcomment -%}
<script>
  (function () {
    'use strict';

    var sub = document.getElementById('bnGiveSub');
    if (!sub) { return; }

    var dataEl = document.getElementById('bnGiveData');
    var DATA = {};
    if (dataEl) {
      try { DATA = JSON.parse(dataEl.textContent || dataEl.innerHTML || '{}'); } catch (e) { DATA = {}; }
    }

    var picker = document.getElementById('bnGivePicker');
    var chooseBtn = document.getElementById('bnGiveChoose');
    var changeBtn = document.getElementById('bnGiveChange');
    var emptyBox = document.getElementById('bnGiveSubEmpty');
    var chosenBox = document.getElementById('bnGiveSubChosen');
    var thumb = document.getElementById('bnGiveSubThumb');
    var titleEl = document.getElementById('bnGiveSubTitle');
    var statusEl = document.getElementById('bnGiveSubStatus');
    var disclosure = document.getElementById('bnGiveSubDisclosure');
    var fineprint = document.getElementById('bnGiveFineprint');

    var STORE_KEY = 'bn_give_pick';
    var busy = false;
    var lastFocus = null;

    // Appstle's wrapper around window.fetch strips `selling_plan` from add
    // payloads. layout/theme.liquid captures a pristine fetch before any app
    // script loads; fall back to window.fetch only so the page still functions
    // if that capture is ever removed.
    function bnFetch(url, opts) {
      var f = window.__bnFetch || window.fetch;
      return f(url, opts);
    }

    function json(url, opts) {
      return bnFetch(url, opts).then(function (res) {
        return res.json().then(function (payload) {
          if (!res.ok) { throw new Error((payload && payload.description) || 'request_failed'); }
          return payload;
        });
      });
    }

    function postJSON(url, body) {
      return json(url, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(body)
      });
    }

    function getCart() {
      return json('/cart.js', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
    }

    function setStatus(text, isError) {
      if (!statusEl) { return; }
      statusEl.textContent = text || '';
      statusEl.className = isError ? 'bn-give__sub-status is-error' : 'bn-give__sub-status';
    }

    function show(el) { if (el) { el.hidden = false; } }
    function hide(el) { if (el) { el.hidden = true; } }

    function renderChosen(title, image) {
      if (titleEl) { titleEl.textContent = title || ''; }
      if (thumb) {
        if (image) { thumb.setAttribute('src', image); thumb.hidden = false; }
        else { thumb.hidden = true; }
      }
      hide(emptyBox);
      show(chosenBox);
      // A recurring charge now exists, so the full disclosure and the recurring
      // fineprint both go up. These two always move together.
      show(disclosure);
      if (fineprint && DATA.fineprintSub) { fineprint.textContent = DATA.fineprintSub; }
    }

    function renderEmpty() {
      hide(chosenBox);
      show(emptyBox);
      hide(disclosure);
      if (fineprint && DATA.fineprint) { fineprint.textContent = DATA.fineprint; }
    }

    function remember(pick) {
      try { window.sessionStorage.setItem(STORE_KEY, JSON.stringify(pick)); } catch (e) {}
    }

    function forget() {
      try { window.sessionStorage.removeItem(STORE_KEY); } catch (e) {}
    }

    /* ---------------- picker open / close ---------------- */

    function focusables() {
      if (!picker) { return []; }
      var nodes = picker.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])');
      var out = [];
      var i;
      for (i = 0; i < nodes.length; i++) {
        if (nodes[i].offsetParent !== null && !nodes[i].disabled) { out.push(nodes[i]); }
      }
      return out;
    }

    function onKeydown(event) {
      if (!picker || picker.hidden) { return; }
      if (event.key === 'Escape' || event.keyCode === 27) {
        event.preventDefault();
        closePicker();
        return;
      }
      if (event.key !== 'Tab' && event.keyCode !== 9) { return; }
      // Focus trap: a modal the keyboard can walk out of is not modal.
      var list = focusables();
      if (!list.length) { return; }
      var first = list[0];
      var last = list[list.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    }

    function openPicker() {
      if (!picker) { return; }
      lastFocus = document.activeElement;
      picker.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      document.addEventListener('keydown', onKeydown);
      var list = focusables();
      if (list.length) { list[0].focus(); }
    }

    function closePicker() {
      if (!picker) { return; }
      picker.hidden = true;
      document.documentElement.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
      lastFocus = null;
    }

    /* ---------------- add / verify / roll back ---------------- */

    // /cart/add.js can return a line WITHOUT selling_plan_allocation even when
    // the plan did apply, so the cart is re-read rather than the add response
    // being trusted. Same pattern as sections/main-product.liquid.
    function findPlanLine(cart, variantId) {
      var i;
      if (!cart || !cart.items) { return null; }
      for (i = 0; i < cart.items.length; i++) {
        var it = cart.items[i];
        if (String(it.variant_id) === String(variantId) && it.selling_plan_allocation) { return it; }
      }
      return null;
    }

    function findAnyLine(cart, variantId) {
      var i;
      if (!cart || !cart.items) { return null; }
      for (i = 0; i < cart.items.length; i++) {
        if (String(cart.items[i].variant_id) === String(variantId)) { return cart.items[i]; }
      }
      return null;
    }

    function removeLine(key) {
      return postJSON('/cart/change.js', { id: key, quantity: 0 });
    }

    // ONE subscription in the cart, always. "Change" has to swap, not stack:
    // two recurring lines is two monthly charges nobody agreed to.
    function dropExistingSubs(cart) {
      var keys = [];
      var i;
      if (cart && cart.items) {
        for (i = 0; i < cart.items.length; i++) {
          if (cart.items[i].selling_plan_allocation) { keys.push(cart.items[i].key); }
        }
      }
      if (!keys.length) { return Promise.resolve(); }
      var chain = Promise.resolve();
      var k;
      for (k = 0; k < keys.length; k++) {
        (function (key) {
          chain = chain.then(function () { return removeLine(key); });
        })(keys[k]);
      }
      return chain;
    }

    function verify(variantId, attempt) {
      return getCart().then(function (cart) {
        var line = findPlanLine(cart, variantId);
        if (line) { return line; }
        if (attempt >= 3) { return null; }
        return new Promise(function (resolve) {
          window.setTimeout(function () { resolve(verify(variantId, attempt + 1)); }, 500);
        });
      });
    }

    function rollback(variantId) {
      return getCart().then(function (cart) {
        var line = findAnyLine(cart, variantId);
        if (!line) { return null; }
        return removeLine(line.key);
      }).catch(function () { return null; });
    }

    function choose(btn) {
      if (busy) { return; }
      var variantId = btn.getAttribute('data-variant-id');
      var planId = btn.getAttribute('data-selling-plan');
      var title = btn.getAttribute('data-title') || '';
      var image = btn.getAttribute('data-image') || '';
      if (!variantId || !planId) { return; }

      busy = true;
      btn.disabled = true;
      closePicker();
      renderChosen(title, image);
      setStatus(DATA.subAdding || 'Adding…', false);

      getCart()
        .then(function (cart) { return dropExistingSubs(cart); })
        .then(function () {
          return postJSON('/cart/add.js', {
            items: [{ id: Number(variantId), quantity: 1, selling_plan: Number(planId) }]
          });
        })
        .then(function () {
          return new Promise(function (resolve) {
            window.setTimeout(resolve, 300);
          });
        })
        .then(function () { return verify(variantId, 1); })
        .then(function (line) {
          if (!line) {
            // The plan did not stick. Never leave a one-time, full-price line
            // sitting in the cart pretending to be a subscription.
            return rollback(variantId).then(function () {
              renderEmpty();
              forget();
              setStatus(DATA.subError || 'Could not add the subscription.', true);
            });
          }
          remember({ variantId: variantId, planId: planId, title: title, image: image });
          setStatus((DATA.subAdded || 'Added — ') + title, false);
          if (typeof window.refreshCartCount === 'function') { window.refreshCartCount(); }
          return null;
        })
        .catch(function () {
          return rollback(variantId).then(function () {
            renderEmpty();
            forget();
            setStatus(DATA.subError || 'Could not add the subscription.', true);
          });
        })
        .then(function () {
          busy = false;
          btn.disabled = false;
        });
    }

    /* ---------------- wiring ---------------- */

    if (chooseBtn && chooseBtn.tagName === 'BUTTON') {
      chooseBtn.addEventListener('click', function (event) {
        event.preventDefault();
        openPicker();
      });
    }

    if (changeBtn) {
      changeBtn.addEventListener('click', function (event) {
        event.preventDefault();
        openPicker();
      });
    }

    if (picker) {
      picker.addEventListener('click', function (event) {
        var el = event.target;
        while (el && el !== picker) {
          if (el.hasAttribute && el.hasAttribute('data-bn-picker-close')) {
            event.preventDefault();
            closePicker();
            return;
          }
          if (el.hasAttribute && el.hasAttribute('data-bn-pick')) {
            event.preventDefault();
            choose(el);
            return;
          }
          el = el.parentNode;
        }
      });
    }

    // Restore the label after a soft navigation back to the page. The CART is
    // the source of truth — this only re-labels a chosen state the server has
    // already rendered, and never invents one the cart does not have.
    if (chosenBox && !chosenBox.hidden && titleEl && !titleEl.textContent) {
      try {
        var saved = JSON.parse(window.sessionStorage.getItem(STORE_KEY) || 'null');
        if (saved && saved.title) { renderChosen(saved.title, saved.image); }
      } catch (e) {}
    }
  })();
</script>

