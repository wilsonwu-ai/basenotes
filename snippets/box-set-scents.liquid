{%- comment -%}
  Curated box set scents. Resolves the three fragrances of a box-set product and renders them.

  Source order: (a) metafield custom.fragrances (list.product_reference), else (b) tags bx1:<handle>,
  bx2:<handle>, bx3:<handle> resolved with all_products[handle]. Shopify sorts tags alphabetically, hence
  the numbered prefix. Missing scents are skipped (never a broken row).

  @param {product} set - the box-set product
  @param {string} mode - 'card' (collection tile: vendor over name rows) or 'page' (links, thumbs, notes, data attrs)
  Page mode marks the <ul> with data-all-available="true|false" so the caller can capture and test it.
  Note: all_products[] is capped (~20 unique handles per page). Prefer the metafield once it exists.
{%- endcomment -%}
{%- liquid
  assign fp = set.metafields.custom.fragrances.value
  assign p1 = blank
  assign p2 = blank
  assign p3 = blank
  if fp != blank and fp.size > 0
    assign p1 = fp[0]
    assign p2 = fp[1]
    assign p3 = fp[2]
  else
    for tag in set.tags
      if tag contains 'bx1:'
        assign h1 = tag | remove_first: 'bx1:' | strip
        assign p1 = all_products[h1]
      elsif tag contains 'bx2:'
        assign h2 = tag | remove_first: 'bx2:' | strip
        assign p2 = all_products[h2]
      elsif tag contains 'bx3:'
        assign h3 = tag | remove_first: 'bx3:' | strip
        assign p3 = all_products[h3]
      endif
    endfor
  endif
  assign all_ok = true
  assign shown = 0
-%}
{%- capture rows -%}
{%- for i in (1..3) -%}
  {%- liquid
    if i == 1
      assign sp = p1
    elsif i == 2
      assign sp = p2
    else
      assign sp = p3
    endif
  -%}
  {%- if sp == blank or sp.title == blank -%}
    {%- continue -%}
  {%- endif -%}
  {%- liquid
    assign shown = shown | plus: 1
    assign sname = sp.title | remove_first: sp.vendor | remove: ' EDP' | remove: 'EDP' | remove: ' Eau de Parfum' | strip
    if sname == blank
      assign sname = sp.title
    endif
    assign slabel = sp.vendor | append: ' ' | append: sname
    unless sp.available
      assign all_ok = false
    endunless
  -%}
  {%- if mode == 'page' -%}
    <li class="bs-scent" data-label="{{ slabel | escape }}"{% unless sp.available %} data-unavailable{% endunless %}>
      <a class="bs-scent__link" href="{{ sp.url }}">
        {%- if sp.featured_image -%}
          <span class="bs-scent__thumb">{{ sp.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 64, height: 64, alt: '' }}</span>
        {%- endif -%}
        <span class="bs-scent__text">
          <span class="bs-scent__vendor">{{ sp.vendor }}</span>
          <span class="bs-scent__name">{{ sname }}</span>
          {%- unless sp.available %}<span class="bs-scent__soldout">Currently unavailable</span>{% endunless -%}
        </span>
      </a>
      {%- render 'box-set-notes', product: sp -%}
    </li>
  {%- else -%}
    <li class="bs-scent"><span class="bs-scent__vendor">{{ sp.vendor }}</span><span class="bs-scent__name">{{ sname }}</span></li>
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}
{%- if mode == 'page' -%}
  {%- if shown < 3 -%}{%- assign all_ok = false -%}{%- endif -%}
  <ul class="bs-scents" data-all-available="{{ all_ok }}" data-scent-count="{{ shown }}">{{ rows }}</ul>
{%- else -%}
  <ul class="bs-scents">{{ rows }}</ul>
{%- endif -%}
