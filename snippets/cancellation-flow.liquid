{% comment %}
  Cancellation Flow — Simple confirmation modal
  Opens via: document.dispatchEvent(new Event('cancellation:open'))
{% endcomment %}

<div class="cf-overlay" id="cancelFlowOverlay" style="display:none;" aria-hidden="true">
  <div class="cf-overlay__bg" data-cf-close></div>
  <div class="cf-panel" role="dialog" aria-label="Cancel subscription">

    <!-- Confirmation Step -->
    <div class="cf-step" data-cf-step="1">
      <h3 class="cf-step__title">Cancel Subscription</h3>
      <p class="cf-step__desc">Are you sure you want to cancel? This will stop all future charges and shipments.</p>
      <button class="cf-cancel-confirm" data-cf-action="confirm-cancel">Yes, cancel my subscription</button>
      <button class="cf-text-link" data-cf-action="keep">Never mind, keep it</button>
    </div>

    <!-- Post-Cancellation Step -->
    <div class="cf-step" data-cf-step="2" style="display:none;">
      <h3 class="cf-step__title">Subscription Cancelled</h3>
      <p class="cf-step__desc">Your subscription has been cancelled. You'll keep access until the end of your current billing period.</p>
      <button class="cf-text-link" data-cf-action="close">Close</button>
    </div>

  </div>
</div>

<style>
  .cf-overlay { position: fixed; inset: 0; z-index: 10002; display: flex; align-items: center; justify-content: center; }
  .cf-overlay__bg { position: absolute; inset: 0; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); }
  .cf-panel { position: relative; z-index: 1; background: #FAF8F5; border-radius: 16px; max-width: 480px; width: 94%; padding: 2.5rem; box-shadow: 0 25px 50px rgba(0,0,0,0.3); }
  .cf-step { text-align: center; }
  .cf-step__title { font-family: 'Cormorant Garamond', Georgia, serif; font-size: 1.5rem; font-weight: 600; color: #2D4641; margin: 0 0 8px; }
  .cf-step__desc { font-size: 14px; color: #666; margin: 0 0 24px; line-height: 1.6; }
  .cf-cancel-confirm { display: block; width: 100%; padding: 14px; background: #c62828; color: #fff; border: none; border-radius: 6px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; font-family: inherit; transition: background 0.2s; margin-bottom: 12px; }
  .cf-cancel-confirm:hover { background: #b71c1c; }
  .cf-cancel-confirm:disabled { background: #e57373; cursor: not-allowed; }
  .cf-text-link { display: block; background: none; border: none; color: #999; font-size: 13px; cursor: pointer; font-family: inherit; margin: 0 auto; padding: 8px; }
  .cf-text-link:hover { color: #666; text-decoration: underline; }
  .cf-error-banner { background: #fdecea; border: 1px solid #f5c6cb;
