  /* Design sheet spec 08: y -5px, 450ms, house curve. */
  .product-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--bn-shadow-card);
    border-color: transparent;
  }

  /* The reveal primitive owns transform on this element and lands on
     .bn-js [data-reveal].is-revealed { transform: none } (0,2,1). The lift has
     to out-specify that or it silently never fires once the card has revealed. */
  .bn-js .product-card[data-reveal].is-revealed:hover {
    transform: translateY(-5px);
  }

  /* --- Defensive: assets/component-variables.css also carries a .product-card
     block, and its .product-card__badge is absolutely pinned to the card's
     top-left, which would stack every badge on top of the others inside
     .product-card__badges. It also treats .product-card__image as a container,
     which it is in the placeholder markup but NOT here, where it is the <img>. */
  .product-card__badge {
    position: static;
    top: auto;
    left: auto;
  }

  img.product-card__image {
    background: none;
    aspect-ratio: auto;
