  /* --- Card shell ---------------------------------------------------------- */
  .product-card {
    background: var(--bn-bone);
    border: 1px solid var(--bn-line-on-bone);
    border-radius: var(--bn-radius-md);
    box-shadow: none;
    transition: transform var(--bn-dur-base) var(--bn-ease),
                box-shadow var(--bn-dur-base) var(--bn-ease),
                border-color var(--bn-dur-base) var(--bn-ease);
