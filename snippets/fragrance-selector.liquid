{% comment %}
  Fragrance Selector — Reusable modal/grid for choosing subscription fragrances

  Usage:
    {% render 'fragrance-selector', mode: 'modal' %}
    {% render 'fragrance-selector', mode: 'inline' %}

  Dispatches CustomEvent 'fragrance:selected' with detail: { id, handle, title, image, family }
  Listen with: document.addEventListener('fragrance:selected', (e) => { ... })
  Open with: document.dispatchEvent(new Event('fragrance-selector:open'))
{% endcomment %}

{%- assign fs_collection = settings.sub_fragrance_collection -%}
{%- assign fs_products = collections[fs_collection].products -%}
{%- if fs_products == blank -%}
  {%- assign fs_products = collections['all'].products -%}
{%- endif -%}

{%- comment -%}
  Family tabs used to be built from every Shopify taxonomy value on the product
  (Aquatic, Citrus, Jasmine, Lavender…). That is why the modal filter bar did
  not match /collections/fragrances (search + brand + scent family).

  Jeff 2026-09-27: chips removed. We still collect family strings so the
  Scent family <select> has options, and so each card can be filtered.
  Taxonomy first, then custom.fragrance_family, then product.type.
  No 20-product cap — the live catalog is 42.
{%- endcomment -%}
{%- assign fs_family_blob = '' -%}
{%- assign fs_brands = '' -%}
{%- for product in fs_products -%}
  {%- if product.handle == 'extra-5ml-vial-add-on' -%}{%- continue -%}{%- endif -%}
  {%- assign fs_brands = fs_brands | append: product.vendor | append: '~~' -%}
  {%- assign p_fam_str = '' -%}
  {%- assign p_tax = product.metafields.shopify.fragrance.value -%}
  {%- if p_tax -%}
    {%- for tv in p_tax -%}
      {%- assign fvs = tv.label | default: tv.name | strip -%}
      {%- unless fvs == blank -%}
        {%- assign p_fam_str = p_fam_str | append: '~~' | append: fvs -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
  {%- if p_fam_str == blank -%}
    {%- assign p_ff = product.metafields.custom.fragrance_family.value -%}
    {%- if p_ff == blank -%}{%- assign p_ff = product.type -%}{%- endif -%}
    {%- assign p_ff_arr = p_ff | join: '~~' | replace: ',', '~~' | split: '~~' -%}
    {%- for fv in p_ff_arr -%}
      {%- assign fvs = fv | strip -%}
      {%- unless fvs == blank -%}
        {%- assign p_fam_str = p_fam_str | append: '~~' | append: fvs -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
  {%- assign fs_family_blob = fs_family_blob | append: p_fam_str -%}
{%- endfor -%}
{%- assign fs_families = fs_family_blob | split: '~~' | uniq | sort_natural -%}
{%- assign fs_brand_list = fs_brands | split: '~~' | uniq | sort_natural -%}

{%- if mode == 'modal' -%}
<div class="fs-overlay" id="fragranceSelectorOverlay" style="display:none;" aria-hidden="true">
  <div class="fs-overlay__bg" data-fs-close></div>
  <div class="fs-panel" role="dialog" aria-label="Choose your fragrance">
{%- endif -%}

<div class="fs-header">
  <div>
    <h3 class="fs-header__title">Choose Your Fragrance</h3>
    <p class="fs-header__subtitle">Select from our exclusive collection of luxury scents</p>
  </div>
  {%- if mode == 'modal' -%}
  <button class="fs-header__close" data-fs-close aria-label="Close">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="24" height="24">
      <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
    </svg>
  </button>
  {%- endif -%}
</div>

{%- comment -%}
  Jeff 2026-09-27: same control pattern as /collections/fragrances —
  search field, Brand select, Scent family select. No tag chips.
{%- endcomment -%}
<div class="fs-toolbar">
  <input type="search" id="fsSearch" class="fs-search" placeholder="Search scents…" autocomplete="off">
  <select id="fsBrand" class="fs-select" aria-label="Brand">
    <option value="">Brand</option>
    {%- for brand in fs_brand_list -%}
      {%- assign brand_clean = brand | strip -%}
      {%- unless brand_clean == blank -%}
        <option value="{{ brand_clean | downcase | escape }}">{{ brand_clean }}</option>
      {%- endunless -%}
    {%- endfor -%}
  </select>
  <select id="fsFamily" class="fs-select" aria-label="Scent family">
    <option value="">Scent family</option>
    {%- for fam in fs_families -%}
      {%- assign fam_clean = fam | strip -%}
      {%- unless fam_clean == blank or fam_clean == 'Fragrance' -%}
        <option value="{{ fam_clean | downcase | escape }}">{{ fam_clean }}</option>
      {%- endunless -%}
    {%- endfor -%}
  </select>
</div>

<div class="fs-grid">
  {%- for product in fs_products -%}
    {%- if product.handle == 'extra-5ml-vial-add-on' -%}{%- continue -%}{%- endif -%}
    {%- assign card_ff_key = '|' -%}
    {%- assign card_ff_display = '' -%}
    {%- assign card_ff_primary = '' -%}
    {%- assign card_tax = product.metafields.shopify.fragrance.value -%}
    {%- if card_tax -%}
      {%- for tv in card_tax -%}
        {%- assign fvs = tv.label | default: tv.name | strip -%}
        {%- unless fvs == blank -%}
          {%- assign fvl = fvs | downcase -%}
          {%- assign card_ff_key = card_ff_key | append: fvl | append: '|' -%}
          {%- if card_ff_display == blank -%}
            {%- assign card_ff_display = fvs -%}
            {%- assign card_ff_primary = fvs -%}
          {%- else -%}
            {%- assign card_ff_display = card_ff_display | append: ', ' | append: fvs -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- if card_ff_display == blank -%}
      {%- assign card_ff = product.metafields.custom.fragrance_family.value -%}
      {%- if card_ff == blank -%}{%- assign card_ff = product.type -%}{%- endif -%}
      {%- assign card_ff_arr = card_ff | join: '~~' | replace: ',', '~~' | split: '~~' -%}
      {%- for fv in card_ff_arr -%}
        {%- assign fvs = fv | strip -%}
        {%- unless fvs == blank -%}
          {%- assign fvl = fvs | downcase -%}
          {%- assign card_ff_key = card_ff_key | append: fvl | append: '|' -%}
          {%- if card_ff_display == blank -%}
            {%- assign card_ff_display = fvs -%}
            {%- assign card_ff_primary = fvs -%}
          {%- else -%}
            {%- assign card_ff_display = card_ff_display | append: ', ' | append: fvs -%}
          {%- endif -%}
        {%- endunless -%}
      {%- endfor -%}
    {%- endif -%}
    {%- assign top_notes = product.metafields.custom.top_notes -%}

    <div
      class="fs-card"
      data-fs-id="{{ product.id }}"
      data-fs-handle="{{ product.handle }}"
      data-fs-family="{{ card_ff_key }}"
      data-fs-brand="{{ product.vendor | downcase | escape }}"
      data-fs-title="{{ product.title | downcase | escape }}"
    >
      <div class="fs-card__image">
        {%- if product.featured_image -%}
          <img
            src="{{ product.featured_image | image_url: width: 400 }}"
            alt="{{ product.title }}"
            loading="lazy"
            width="200"
            height="200"
          >
        {%- else -%}
          <div class="fs-card__placeholder">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="48" height="48">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
        {%- endif -%}
      </div>
      <div class="fs-card__content">
        <h4 class="fs-card__name">{{ product.title }}</h4>
        <span class="fs-card__family">{{ card_ff_display }}</span>
        {%- if top_notes != blank -%}
          <div class="fs-card__notes">
            <span class="fs-card__notes-label">Top:</span> {{ top_notes }}
          </div>
        {%- endif -%}
        {%- comment -%} Jeff 2026-09-27: 5ml price is $20, not "retail value". {%- endcomment -%}
        <div class="fs-card__price">
          <span class="fs-card__retail">{{ product.price | money }}</span>
        </div>
        <button
          class="btn btn--primary btn--small fs-card__select"
          data-fs-select
          data-product-id="{{ product.id }}"
          data-product-handle="{{ product.handle }}"
          data-product-title="{{ product.title | escape }}"
          data-product-image="{{ product.featured_image | image_url: width: 400 }}"
          data-product-family="{{ card_ff_primary }}"
        >
          Add to Queue
        </button>
      </div>
    </div>
  {%- endfor -%}
</div>

{%- if fs_products.size == 0 -%}
  <div class="fs-empty">
    <p>No fragrances available. Please check back soon.</p>
  </div>
{%- endif -%}

{%- if mode == 'modal' -%}
  </div>
</div>
{%- endif -%}

<style>
.fs-overlay {
  position: fixed;
  inset: 0;
  z-index: 10001;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fs-overlay__bg {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(4px);
}
.fs-panel {
  position: relative;
  z-index: 1;
  background: var(--color-background, #FAF8F5);
  border-radius: 12px;
  max-width: 900px;
  width: 94%;
  max-height: 90vh;
  overflow-y: auto;
  padding: 2rem;
  box-shadow: 0 25px 50px rgba(0,0,0,0.25);
}
.fs-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1.5rem;
}
.fs-header__title {
  font-family: var(--font-heading, 'Cormorant Garamond', serif);
  font-size: 1.75rem;
  color: var(--color-primary, #2D4641);
  margin: 0;
}
.fs-header__subtitle {
  color: var(--color-text-muted, #666);
  font-size: 0.9rem;
  margin: 0.25rem 0 0;
}
.fs-header__close {
  background: none;
  border: none;
  cursor: pointer;
  padding: 0.5rem;
  color: var(--color-primary, #2D4641);
  border-radius: 50%;
}
.fs-header__close:hover { background: rgba(0,0,0,0.05); }

/* Jeff 2026-09-27: collection-page toolbar */
.fs-toolbar {
  display: grid;
  grid-template-columns: 1fr 160px 160px;
  gap: 0.6rem;
  margin-bottom: 1.5rem;
}
.fs-search,
.fs-select {
  height: 44px;
  padding: 0 0.75rem;
  border: 1px solid #E8E6E3;
  background: #fff;
  color: #2D4641;
  font-size: 0.9rem;
  font-family: inherit;
}

.fs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.fs-card {
  background: #fff;
  border-radius: 10px;
  overflow: hidden;
  border: 2px solid transparent;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.fs-card:hover {
  border-color: var(--color-secondary, #C9A962);
  box-shadow: 0 4px 20px rgba(201,169,98,0.15);
}
/* Jeff 2026-09-27: contain + padding so oversized pack shots sit
   in the same frame as tight crops. Cover was blowing some bottles up. */
.fs-card__image {
  aspect-ratio: 1;
  overflow: hidden;
  background: #F5F3F0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}
.fs-card__image img {
  width: 100%;
  height: 100%;
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
  object-position: center;
}
.fs-card__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center; color: #ccc;
}
.fs-card__content { padding: 1rem; }
.fs-card__name {
  font-family: var(--font-heading, 'Cormorant Garamond', serif);
  font-size: 1.1rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-primary, #2D4641);
  margin: 0 0 0.25rem;
}
.fs-card__family {
  display: inline-block;
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-secondary, #C9A962);
  margin-bottom: 0.5rem;
}
.fs-card__notes {
  font-size: 0.8rem;
  color: var(--color-text-muted, #666);
  margin-bottom: 0.5rem;
}
.fs-card__price { margin-bottom: 0.75rem; }
.fs-card__retail { font-size: 0.8rem; color: var(--color-text-muted, #666); }
.fs-card__select { width: 100%; font-size: 0.75rem; padding: 0.6rem 1rem; }
.fs-empty { text-align: center; padding: 3rem; color: #666; }

@media (max-width: 768px) {
  .fs-panel { width: 100%; height: 100%; max-height: 100vh; border-radius: 0; padding: 1.25rem; }
  .fs-grid { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
  .fs-toolbar { grid-template-columns: 1fr; }
  .fs-header__title { font-size: 1.35rem; }
}
</style>

<script>
(function() {
  'use strict';

  var overlay = document.getElementById('fragranceSelectorOverlay');
  if (!overlay) return;

  function openSelector() {
    overlay.style.display = '';
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeSelector() {
    overlay.style.display = 'none';
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.addEventListener('fragrance-selector:open', openSelector);

  overlay.querySelectorAll('[data-fs-close]').forEach(function(el) {
    el.addEventListener('click', closeSelector);
  });

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && overlay.style.display !== 'none') closeSelector();
  });

  // Jeff 2026-09-27: collection-style filters (search / brand / family).
  // Family still uses the pipe-delimited card key so "fresh" ≠ "freshwater".
  var cards = overlay.querySelectorAll('.fs-card');
  var searchEl = overlay.querySelector('#fsSearch');
  var brandEl = overlay.querySelector('#fsBrand');
  var familyEl = overlay.querySelector('#fsFamily');

  function applyFsFilters() {
    var q = (searchEl && searchEl.value || '').toLowerCase();
    var brand = (brandEl && brandEl.value || '').toLowerCase();
    var family = (familyEl && familyEl.value || '').toLowerCase();

    cards.forEach(function(card) {
      var title = card.getAttribute('data-fs-title') || '';
      var handle = card.getAttribute('data-fs-handle') || '';
      var cardBrand = card.getAttribute('data-fs-brand') || '';
      var cardFamily = (card.getAttribute('data-fs-family') || '').toLowerCase();
      var show =
        (!q || title.indexOf(q) !== -1 || handle.indexOf(q) !== -1 || cardBrand.indexOf(q) !== -1) &&
        (!brand || cardBrand === brand) &&
        (!family || cardFamily.indexOf('|' + family + '|') !== -1);
      card.style.display = show ? '' : 'none';
    });
  }

  if (searchEl) searchEl.addEventListener('input', applyFsFilters);
  if (brandEl) brandEl.addEventListener('change', applyFsFilters);
  if (familyEl) familyEl.addEventListener('change', applyFsFilters);

  overlay.querySelectorAll('[data-fs-select]').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.dispatchEvent(new CustomEvent('fragrance:selected', {
        detail: {
          id: btn.dataset.productId,
          handle: btn.dataset.productHandle,
          title: btn.dataset.productTitle,
          image: btn.dataset.productImage,
          family: btn.dataset.productFamily
        }
      }));
      closeSelector();
    });
  });
})();
</script>