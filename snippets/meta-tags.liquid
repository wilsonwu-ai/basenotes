{%- comment -%}
  Meta Tags for SEO and Social Sharing
{%- endcomment -%}

{%- liquid
  assign default_social_description = 'Luxury fragrance subscription — $20/month for a 5ml atomizer of a designer or niche fragrance. No surcharges, cancel anytime.'
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: default_social_description
  assign og_type = 'website'

  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  endif
-%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:url" content="{{ canonical_url }}">

{%- if template.name == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if product.featured_image -%}
    <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="1200">
  {%- endif -%}
{%- elsif template.name == 'collection' and collection.image -%}
  <meta property="og:image" content="https:{{ collection.image | image_url: width: 1200 }}">
{%- elsif template.name == 'article' and article.image -%}
  <meta property="og:image" content="https:{{ article.image | image_url: width: 1200 }}">
{%- elsif settings.share_image -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | json }},
      "image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},
      {%- comment -%}
        sku/mpn were being FABRICATED: sku fell back to product.id (a number, so it emitted
        unquoted and invalid) and mpn was the URL handle. Neither is a real identifier, and a wrong
        identifier is worse than an absent one — Google clusters offers on it. Emit them only when a
        genuine variant SKU exists.
      {%- endcomment -%}
      {%- assign v = product.selected_or_first_available_variant -%}
      {%- if v.sku != blank %}"sku": {{ v.sku | json }},
      "mpn": {{ v.sku | json }},{% endif %}
      "category": "Beauty > Personal Care > Cosmetics > Fragrance",
      "brand": {
        "@type": "Brand",
        "name": {{ product.vendor | json }}
      },
      "offers": {
        "@type": "Offer",
        "url": {{ product.url | prepend: shop.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | money_without_currency | json }},
        "itemCondition": "https://schema.org/NewCondition",
        "priceValidUntil": {{ 'now' | date: '%Y' | plus: 1 | append: '-12-31' | json }},
        {%- comment -%}
          A bare price tells Google (and any AI shopping agent) nothing about the fact that this
          charge repeats monthly, which is the entire product. UnitPriceSpecification is the
          schema.org way to say "$20, billed every 1 month". Only emitted where a selling plan
          actually exists, so one-time products stay a plain price.
        {%- endcomment -%}
        {%- if product.selling_plan_groups.size > 0 %}
        "priceSpecification": {
          "@type": "UnitPriceSpecification",
          "price": {{ product.price | money_without_currency | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "billingDuration": 1,
          "billingIncrement": "MONTH",
          "unitCode": "MON"
        },
        {%- endif %}
        "shippingDetails": {
          "@type": "OfferShippingDetails",
          "shippingRate": {
            "@type": "MonetaryAmount",
            "value": {% if product.selling_plan_groups.size > 0 %}"0.00"{% else %}"4.99"{% endif %},
            "currency": {{ cart.currency.iso_code | json }}
          },
          "shippingDestination": {
            "@type": "DefinedRegion",
            "addressCountry": "US"
          },
          "deliveryTime": {
            "@type": "ShippingDeliveryTime",
            "handlingTime": { "@type": "QuantitativeValue", "minValue": 1, "maxValue": 2, "unitCode": "DAY" },
            "transitTime": { "@type": "QuantitativeValue", "minValue": 3, "maxValue": 5, "unitCode": "DAY" }
          }
        },
        "hasMerchantReturnPolicy": {
          "@type": "MerchantReturnPolicy",
          "applicableCountry": "US",
          "returnPolicyCategory": "https://schema.org/MerchantReturnFiniteReturnWindow",
          "merchantReturnDays": 30,
          "returnMethod": "https://schema.org/ReturnByMail",
          "returnFees": "https://schema.org/FreeReturn"
        },
        "availability": {% if product.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
      }
    }
  </script>
{%- endif -%}
