{% doc %}
  Social metadata and factual product offers. The default offer is a one-time
  purchase; a separate offer describes a real recurring selling-plan allocation.

  @param {string} [seo_title] - The resolved page title from the layout.
  @param {string} [meta_description] - The resolved description from the layout.
{% enddoc %}

{%- liquid
  assign default_social_description = 'Discover authentic fragrance in a one-time 5 ml vial. Explore the Monthly Rotation subscription and full-bottle availability at Base Note.'
  assign og_title = seo_title | default: page_title | default: shop.name
  assign og_description = meta_description | default: page_description | default: shop.description | default: default_social_description
  assign og_type = 'website'
  assign social_url = canonical_url
  assign social_image = settings.share_image
  assign is_commercial_product = false
  if template.name == 'product'
    assign schema_variant = product.selected_or_first_available_variant
    assign social_image = schema_variant.featured_image | default: product.featured_image | default: social_image
    if product.handle != 'extra-5ml-vial-add-on' and template.suffix != 'giveaway' and schema_variant.price > 0
      assign og_type = 'product'
      assign is_commercial_product = true
    endif
  elsif template.name == 'collection'
    assign social_image = collection.image | default: social_image
    if collection.handle == 'all'
      assign social_url = shop.url | append: '/collections/fragrances'
    endif
  elsif template.name == 'article'
    assign og_type = 'article'
    assign social_image = article.image | default: social_image
  endif
  assign currency_code = cart.currency.iso_code | default: shop.currency
-%}

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape_once }}">
<meta property="og:description" content="{{ og_description | strip_html | escape_once }}">
<meta property="og:url" content="{{ social_url | escape }}">
{%- if is_commercial_product -%}
  <meta property="product:price:amount" content="{{ schema_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ currency_code }}">
{%- endif -%}
{%- if social_image -%}
  <meta property="og:image" content="https:{{ social_image | image_url: width: 1200 }}">
  <meta property="og:image:alt" content="{{ social_image.alt | default: og_title | escape_once }}">
  <meta name="twitter:image" content="https:{{ social_image | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape_once }}">
<meta name="twitter:description" content="{{ og_description | strip_html | escape_once }}">

{%- if is_commercial_product -%}
  {%- liquid
    assign schema_name = product.title
    assign variant_format = schema_variant.title | downcase | remove: ' '
    assign name_format = product.title | downcase | remove: ' '
    assign is_vial = false
    if variant_format contains '5ml'
      assign is_vial = true
      unless name_format contains '5ml'
        assign schema_name = schema_name | append: ' — 5 ml travel atomizer'
      endunless
    endif
    assign schema_description = product.description | strip_html | strip
    if is_vial
      assign schema_description = 'A 5 ml Base Note travel atomizer, decanted from the original fragrance. Buy once, or choose the optional recurring Monthly Rotation subscription. ' | append: schema_description
    endif
    assign offer_url = shop.url | append: product.url | append: '?variant=' | append: schema_variant.id
    assign monthly_allocation = schema_variant.selling_plan_allocations.first
    assign monthly_plan_name = monthly_allocation.selling_plan.name | downcase
    assign monthly_plan_matches = false
    if monthly_allocation and monthly_allocation.selling_plan.recurring_deliveries and monthly_plan_name contains 'monthly'
      assign monthly_plan_matches = true
    endif
    assign refund_policy_text = shop.refund_policy.body | strip_html | strip | downcase
  -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "@id": {{ shop.url | append: product.url | append: '#product' | json }},
      "name": {{ schema_name | json }},
      "description": {{ schema_description | json }},
      {%- if social_image %}"image": {{ social_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
      {%- if schema_variant.sku != blank %}"sku": {{ schema_variant.sku | json }},{% endif %}
      "category": "Fragrance",
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- if is_vial %}"size": "5 ml",{% endif %}
      "offers": [
        {
          "@type": "Offer",
          "name": "One-time purchase",
          "url": {{ offer_url | json }},
          "priceCurrency": {{ currency_code | json }},
          "price": {{ schema_variant.price | divided_by: 100.0 | json }},
          "itemCondition": "https://schema.org/NewCondition",
          "seller": { "@type": "Organization", "name": {{ shop.name | json }} },
          {%- if refund_policy_text == 'no returns.' or refund_policy_text == 'no returns' %}
          "hasMerchantReturnPolicy": {
            "@type": "MerchantReturnPolicy",
            "returnPolicyCategory": "https://schema.org/MerchantReturnNotPermitted",
            "merchantReturnLink": {{ shop.refund_policy.url | prepend: shop.url | json }}
          },
          {%- endif %}
          "availability": {% if schema_variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
        }
        {%- if monthly_plan_matches -%}
        ,{
          "@type": "Offer",
          "name": "Monthly Rotation subscription",
          "url": {{ offer_url | append: '&selling_plan=' | append: monthly_allocation.selling_plan.id | json }},
          "description": "An optional recurring monthly fragrance subscription. The first-shipment and ongoing prices are shown separately.",
          "priceCurrency": {{ currency_code | json }},
          "price": {{ monthly_allocation.price | divided_by: 100.0 | json }},
          "priceSpecification": [
            {
              "@type": "UnitPriceSpecification",
              "name": "First shipment",
              "price": {{ monthly_allocation.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ currency_code | json }},
              "billingDuration": "P1M",
              "billingIncrement": 1,
              "unitCode": "MON"
            }
            {%- assign recurring_adjustment = monthly_allocation.price_adjustments | last -%}
            {%- if recurring_adjustment -%}
            ,{
              "@type": "UnitPriceSpecification",
              "name": "Each monthly renewal after the first shipment",
              "price": {{ recurring_adjustment.price | divided_by: 100.0 | json }},
              "priceCurrency": {{ currency_code | json }},
              "billingIncrement": 1,
              "unitCode": "MON"
            }
            {%- endif -%}
          ],
          "itemCondition": "https://schema.org/NewCondition",
          "availability": {% if schema_variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %}
        }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
