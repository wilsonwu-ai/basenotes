{% doc %}
  Compact fragrance card with actual atomizer format and original bottle reference.
  @param {product} product - Shopify fragrance product.
  @param {string} section_id - Unique section identifier.
  @param {boolean} [compact] - Use Jeff's compact bordered catalog tile.
{% enddoc %}
{%- liquid
  assign vial = blank
  for variant in product.variants
    assign variant_title = variant.title | downcase | remove: ' '
    if variant_title contains '5ml'
      assign vial = variant
      break
    endif
  endfor
  assign bottle = blank
  for variant in product.variants
    if variant.id != vial.id
      assign variant_compact = variant.title | downcase | remove: ' '
      if variant_compact contains 'ml' or variant_compact contains 'oz' or variant_compact contains 'fullbottle'
        assign bottle = variant
        break
      endif
    endif
  endfor
  assign scent_name = product.title | split: ' — ' | first | remove_first: product.vendor | strip
  assign gender = 'unclassified'
  assign tags_down = product.tags | join: '|' | downcase
  assign title_down = product.title | downcase
  if tags_down contains 'unisex'
    assign gender = 'unisex'
  elsif tags_down contains 'feminine' or title_down contains 'for her' or title_down contains 'pour femme'
    assign gender = 'her'
  elsif tags_down contains 'masculine' or title_down contains 'for him' or title_down contains 'pour homme'
    assign gender = 'him'
  endif
-%}
{%- unless product.handle == 'extra-5ml-vial-add-on' or product.price == 0 or vial == blank -%}
<article class="scent-card{% if compact %} scent-card--reference{% endif %}" data-scent-card data-gender="{{ gender }}" data-tags="{{ tags_down | escape }}" data-name="{{ product.title | escape }}" aria-labelledby="ScentCard-{{ section_id }}-{{ product.id }}">
  {%- if compact -%}
  <a class="scent-card__media" href="{{ product.url }}" aria-label="{{ 'fragrance_reference.explore' | t: fragrance: product.title | escape }}">
    {%- liquid
      # Products with a listed full bottle open on the 5ml photo so the size switch shows the right bottle; all other cards keep the product photo.
      assign card_image = product.featured_image
      if bottle != blank and vial.featured_image
        assign card_image = vial.featured_image
      endif
      assign card_alt = card_image.alt | default: product.title
    -%}
    {%- if card_image -%}
      {{ card_image | image_url: width: 240 | image_tag: loading: 'lazy', widths: '120, 180, 240', sizes: '66px', class: 'scent-card__reference-image', alt: card_alt }}
    {%- else -%}
      <span class="scent-card__vial">{% render 'vial-illustration', product: product %}</span>
    {%- endif -%}
  </a>
  <h2 id="ScentCard-{{ section_id }}-{{ product.id }}"><a href="{{ product.url }}">{{ product.title }}</a></h2>
  {%- comment -%} Ratings render only from real Judge.me / review data; nothing is shown until reviews exist. {%- endcomment -%}
  {%- if product.metafields.reviews.rating_count.value > 0 or product.metafields.reviews.count.value > 0 or product.metafields.judgeme.review_count > 0 -%}{% render 'product-review-badge', product: product, surface: 'card' %}{%- endif -%}
  {%- comment -%} Size switch replaces the old "House · 5ml" line (Jeff, 2026-09-10). A listed, available full bottle is selectable; otherwise "Full bottle" opens the bottle enquiry, matching the product page. {%- endcomment -%}
  <div class="scent-card__sizes" role="group" aria-label="{{ 'Size for ' | append: product.title | escape }}">
    <button type="button" class="scent-card__size" data-card-size data-kind="vial" data-variant-id="{{ vial.id }}" data-price="{{ vial.price }}" data-available="{{ vial.available }}" aria-pressed="true">5ml</button>
    {%- if bottle != blank and bottle.available -%}
      <button type="button" class="scent-card__size" data-card-size data-kind="bottle" data-variant-id="{{ bottle.id }}" data-price="{{ bottle.price }}" data-available="true" data-label="{{ bottle.title | escape }}"{% if bottle.featured_image %} data-image="{{ bottle.featured_image | image_url: width: 240 }}"{% endif %} aria-pressed="false" aria-label="Full bottle ({{ bottle.title | escape }})">Full bottle</button>
    {%- else -%}
      <a class="scent-card__size scent-card__size--request" href="/pages/full-bottles?fragrance={{ product.title | url_encode }}#BottleEnquiry" aria-label="Ask about a full bottle of {{ product.title | escape }}" title="Ask about a full bottle">Full bottle</a>
    {%- endif -%}
  </div>
  {%- else -%}
  <a class="scent-card__media" href="{{ product.url }}" aria-label="Explore {{ product.title | escape }} in a 5ml vial">
    <span class="scent-card__vial">{% render 'vial-illustration', product: product %}</span>
    {%- if product.featured_image -%}<span class="scent-card__original">{{ product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', widths: '100, 150, 200', sizes: '64px', alt: product.featured_image.alt | default: product.title }}<span>Original fragrance</span></span>{%- endif -%}
  </a>
  <p class="scent-card__brand">{{ product.vendor }}</p>
  <h2 id="ScentCard-{{ section_id }}-{{ product.id }}"><a href="{{ product.url }}">{{ scent_name }}</a></h2>
  <p class="scent-card__format">5ml travel atomizer</p>
  {%- endif -%}
  <form method="post" action="{{ routes.cart_add_url }}" data-scent-add data-kind="vial" data-variant-id="{{ vial.id }}" data-handle="{{ product.handle }}" data-title="{{ product.title | escape }}" data-price="{{ vial.price }}" data-add-label="{% if compact %}{{ 'fragrance_reference.add' | t | escape }}{% else %}Add vial{% endif %}" data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}">
    <input type="hidden" name="id" value="{{ vial.id }}"><input type="hidden" name="quantity" value="1">
    <button type="submit" {% unless vial.available %}disabled{% endunless %}>{% if vial.available %}{% if compact %}{{ 'fragrance_reference.add' | t }}{% else %}Add vial{% endif %} <span aria-hidden="true">·</span> <span data-scent-price>{{ vial.price | money_without_trailing_zeros }}</span>{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</button>
  </form>
</article>
{%- endunless -%}
