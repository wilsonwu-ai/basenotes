{%- comment -%}
  Monthly Rotation explainer dialog. ONE source of truth for the Rotation wording, rendered on the
  homepage (the "Three ways" Rotation card) and on the cart page, so the two can never drift. Jeff
  screenshotted our own homepage modal and asked for it in the cart; this is that same markup, not
  a second copy of it. The three numbered points are the ROSCA-relevant disclosure, so treat the
  copy as frozen: change it here and both surfaces move together.

  Parameters:
    modal_id  - unique id for the dialog on this page. Every selector, every id and the whole
                script are scoped to it, so two instances on one page cannot collide. A section
                that declares a preset must derive this from section.id, never hardcode it.
    opener_id - id of the element that opens it. Works both for a role="button" element
                (click plus Enter/Space) and for a real <a href> (click, with preventDefault).
                The opener SHOULD carry aria-haspopup="dialog" and aria-controls="<modal_id>",
                or assistive tech announces a plain link and then silently relocates focus.
                NOTE: a no-JS fallback exists ONLY when the opener is an anchor with a real href.
                The homepage opener is an <article role="button"> with no href, so with JS off the
                explainer is simply unavailable there; the cart opener is an anchor and still works.
    show_cta  - true renders the "Start Monthly Rotation" link to /pages/monthly-rotation,
                false omits that link entirely.

  Usage (homepage):
    render 'rotation-explainer', modal_id: rotation_modal_id, opener_id: rotation_opener_id, show_cta: true

  Self-contained on purpose: markup, style and script all ship from here. The cart page does not
  load the homepage section's compiled stylesheet, and a snippet cannot use the section stylesheet
  tag, so the CSS ships as a plain inline style block. Every --scent-* token has a literal fallback
  because those variables are only defined on .scent-home / .fragrance-catalog / .scent-route; the
  fallbacks are the same values, so the homepage renders exactly as it did before the extraction.
{%- endcomment -%}
{%- liquid
  assign rx_modal = modal_id | default: 'rotationModal'
  assign rx_opener = opener_id | default: 'openRotation'
  assign rx_title = rx_modal | append: '-title'
-%}
<div class="bn-modal-bg" id="{{ rx_modal }}" role="dialog" aria-modal="true" aria-labelledby="{{ rx_title }}" hidden>
  <div class="bn-modal">
    <button class="bn-modal__close" type="button" data-rotation-close aria-label="Close">&times;</button>
    <h3 id="{{ rx_title }}">Monthly Rotation</h3>
    <ol>
      <li>Choose any fragrance from our full catalog. Plan up to 5 months ahead, or leave a month blank and we&rsquo;ll send that month&rsquo;s fragrance of the month.</li>
      <li>A new 5ml atomizer ships automatically every month &mdash; about 60 sprays, a month&rsquo;s supply.</li>
      <li>Swap, skip, or cancel anything from your account. No phone calls, no fees.</li>
    </ol>
    {%- if show_cta -%}
      <a class="scent-button bn-modal__cta" href="/pages/monthly-rotation">Start Monthly Rotation</a>
    {%- endif -%}
  </div>
</div>

<style>
  /* z-index must clear the sticky header (100), cart-feedback (1100) and cart-addon-picker (1200),
     which all share the cart page with this dialog. Deliberately BELOW cookie-consent (10000):
     that banner is a consent gate and must never be obscured by an explainer. */
  #{{ rx_modal }} { position: fixed; inset: 0; z-index: 1300; display: flex; align-items: center; justify-content: center; padding: 1.25rem; background: rgb(34 57 43 / 45%); }
  #{{ rx_modal }}[hidden] { display: none !important; }
  #{{ rx_modal }}, #{{ rx_modal }} * { box-sizing: border-box; }
  #{{ rx_modal }} :focus-visible { outline: 2px solid var(--scent-green, #22392b); outline-offset: 5px; }
  #{{ rx_modal }} .bn-modal { position: relative; width: 100%; max-width: 30rem; max-height: calc(100vh - 2.5rem); overflow-y: auto; padding: 1.75rem 1.6rem 1.5rem; border: 1px solid var(--scent-line, #d9d4c8); border-radius: .4rem; background: var(--scent-cream, #f4efe3); color: var(--scent-ink, #24372b); font: 400 1rem/1.6 'Jost', sans-serif; text-align: start; }
  #{{ rx_modal }} .bn-modal h3 { margin: 0 0 .9rem; color: inherit; font-family: 'Playfair Display', Georgia, serif; font-size: 1.9rem; font-weight: 500; letter-spacing: -.035em; }
  #{{ rx_modal }} .bn-modal ol { margin: 0 0 1.2rem; padding-inline-start: 1.2rem; }
  #{{ rx_modal }} .bn-modal li { margin-block-end: .7rem; color: var(--scent-muted, #62675d); font: .88rem/1.6 'Jost', sans-serif; }
  #{{ rx_modal }} .bn-modal__close { position: absolute; top: .5rem; right: .6rem; width: 2.75rem; height: 2.75rem; border: 0; background: transparent; color: var(--scent-muted, #62675d); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  /* Same declarations as .scent-button in scent-storefront.css, repeated here with literal
     fallbacks so the link still looks like a button on a page that never loads that file. */
  #{{ rx_modal }} .bn-modal__cta { display: inline-flex; gap: 2rem; min-height: 3.5rem; align-items: center; justify-content: space-between; padding: .9rem 1.5rem; border: 1px solid var(--scent-green, #22392b); border-radius: 0; background: var(--scent-green, #22392b); color: var(--scent-cream, #f4efe3) !important; font: 500 .78rem/1.4 'Jost', sans-serif; letter-spacing: .09em; text-transform: uppercase; text-decoration: none; cursor: pointer; transition: background .18s ease, box-shadow .18s ease; }
  #{{ rx_modal }} .bn-modal__cta:hover { background: #314e3b; box-shadow: 0 3px 0 #ac9159; }
</style>

<script>
  (function () {
    'use strict';
    // Bails safely if either node is missing: on the homepage the opener is the whole Rotation
    // card, elsewhere it may be a link that is only rendered under a condition.
    var modal = document.getElementById({{ rx_modal | json }});
    var opener = document.getElementById({{ rx_opener | json }});
    if (!modal || !opener) return;

    var isLink = opener.tagName === 'A' && !!opener.getAttribute('href');
    var isButtonRole = (opener.getAttribute('role') || '').toLowerCase() === 'button';
    var FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
    var lastFocus = null;
    var prevOverflow = '';

    function focusables() {
      return Array.prototype.slice.call(modal.querySelectorAll(FOCUSABLE));
    }

    function openModal() {
      lastFocus = document.activeElement;
      modal.hidden = false;
      // Scroll lock: without it a touch-drag over the backdrop scrolls the page underneath.
      prevOverflow = document.body.style.overflow;
      document.body.style.overflow = 'hidden';
      var closeBtn = modal.querySelector('[data-rotation-close]');
      if (closeBtn) closeBtn.focus();
    }

    function closeModal() {
      if (modal.hidden) return;
      modal.hidden = true;
      document.body.style.overflow = prevOverflow;
      if (lastFocus && lastFocus.isConnected) lastFocus.focus();
    }

    opener.addEventListener('click', function (e) {
      // JS on: the dialog opens instead of navigating. JS off: an anchor opener follows its href.
      if (isLink) e.preventDefault();
      openModal();
    });

    if (isButtonRole) {
      opener.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openModal(); }
      });
    }

    // Focus containment. The dialog declares aria-modal="true", which confines a screen reader's
    // virtual cursor, so keyboard focus must be confined to match. On the cart page the elements
    // directly behind this scrim are the ROSCA consent checkbox and "Continue to payment" - a
    // loose Tab must never reach them while the dialog is open.
    modal.addEventListener('keydown', function (e) {
      if (e.key !== 'Tab') return;
      var items = focusables();
      if (!items.length) { e.preventDefault(); return; }
      var first = items[0];
      var last = items[items.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });

    modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });

    var closeControl = modal.querySelector('[data-rotation-close]');
    if (closeControl) closeControl.addEventListener('click', closeModal);

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });
  })();
</script>
