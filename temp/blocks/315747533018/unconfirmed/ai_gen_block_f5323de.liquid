{% enddoc %}
{{ 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Work+Sans:wght@400;500;600&display=swap' | stylesheet_tag }}

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .bn-how-it-works-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background: {{ block.settings.bg_color }};
    padding: 96px 64px 112px;
    color: {{ block.settings.text_color }};
    font-family: 'Work Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    box-sizing: border-box;
  }
  .bn-how-it-works-{{ ai_gen_id }} *, .bn-how-it-works-{{ ai_gen_id }} *::before, .bn-how-it-works-{{ ai_gen_id }} *::after { box-sizing: inherit; }
  .bn-hiw__inner-{{ ai_gen_id }} { max-width: 1280px; margin: 0 auto; display: flex; flex-direction: column; align-items: center; }
  .bn-hiw__header-{{ ai_gen_id }} { max-width: 640px; margin: 0 0 80px; text-align: center; }
  .bn-hiw__eyebrow-{{ ai_gen_id }} { display: block; margin: 0 0 20px; color: {{ block.settings.accent_color }}; font-size: 12px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; }
  .bn-hiw__heading-{{ ai_gen_id }} { margin: 0 0 20px; color: {{ block.settings.text_color }}; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 52px; font-style: italic; font-weight: 500; line-height: 1.12; }
  .bn-hiw__subheading-{{ ai_gen_id }} { margin: 0; color: {{ block.settings.muted_color }}; font-size: 17px; line-height: 1.6; }
  .bn-hiw__steps-{{ ai_gen_id }} { display: flex; align-items: stretch; justify-content: center; width: 100%; }
  .bn-hiw__step-{{ ai_gen_id }} { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 0 32px; }
  .bn-hiw__icon-{{ ai_gen_id }} { width: 44px; height: 44px; margin-bottom: 28px; display: flex; align-items: center; justify-content: center; color: {{ block.settings.accent_color }}; }
  .bn-hiw__icon-{{ ai_gen_id }} svg { display: block; width: 36px; height: 36px; }
  .bn-hiw__number-{{ ai_gen_id }} { display: block; margin-bottom: 10px; color: {{ block.settings.accent_color }}; font-family: 'Cormorant Garamond', Georgia, serif; font-size: 15px; font-weight: 600; letter-spacing: .1em; }
  .bn-hiw__step-title-{{ ai_gen_id }} { margin: 0 0 10px; color: {{ block.settings.text_color }}; font-size: 18px; font-weight: 600; }
  .bn-hiw__step-text-{{ ai_gen_id }} { margin: 0; color: {{ block.settings.muted_color }}; font-size: 14.5px; line-height: 1.65; }
  .bn-hiw__divider-{{ ai_gen_id }} { width: 1px; flex: none; margin-top: 8px; background: {{ block.settings.divider_color }}; }
  .bn-hiw__button-{{ ai_gen_id }} { display: inline-flex; align-items: center; justify-content: center; width: auto; margin-top: 72px; padding: 18px 44px; border-radius: 4px; background: {{ block.settings.accent_color }}; color: {{ block.settings.button_text_color }}; font-size: 13px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; }
  .bn-hiw__button-{{ ai_gen_id }}:hover, .bn-hiw__button-{{ ai_gen_id }}:focus-visible { opacity: .85; }
  .bn-hiw__button-{{ ai_gen_id }}:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 4px; }
  @media screen and (max-width: 749px) {
    .bn-how-it-works-{{ ai_gen_id }} { padding: 64px 28px 72px; }
    .bn-hiw__header-{{ ai_gen_id }} { margin-bottom: 52px; }
    .bn-hiw__eyebrow-{{ ai_gen_id }} { margin-bottom: 16px; font-size: 11px; letter-spacing: .2em; }
    .bn-hiw__heading-{{ ai_gen_id }} { margin-bottom: 14px; font-size: 34px; }
    .bn-hiw__subheading-{{ ai_gen_id }} { font-size: 15px; }
    .bn-hiw__steps-{{ ai_gen_id }} { flex-direction: column; }
    .bn-hiw__step-{{ ai_gen_id }} { width: 100%; flex-direction: row; gap: 18px; padding: 26px 0; }
    .bn-hiw__icon-{{ ai_gen_id }} { width: 40px; height: 40px; flex: none; margin-bottom: 0; }
    .bn-hiw__step-copy-{{ ai_gen_id }} { display: flex; flex-direction: column; align-items: flex-start; }
    .bn-hiw__number-{{ ai_gen_id }} { margin-bottom: 6px; font-size: 14px; }
    .bn-hiw__step-title-{{ ai_gen_id }} { margin-bottom: 8px; font-size: 16.5px; }
    .bn-hiw__step-text-{{ ai_gen_id }} { font-size: 14px; }
    .bn-hiw__divider-{{ ai_gen_id }} { width: 100%; height: 1px; margin: 0; }
    .bn-hiw__button-{{ ai_gen_id }} { width: 100%; margin-top: 44px; padding: 18px 0; }
  }
{% endstyle %}

<how-it-works-{{ ai_gen_id }} class="bn-how-it-works-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="bn-hiw__inner-{{ ai_gen_id }}">
    <header class="bn-hiw__header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}<span class="bn-hiw__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</span>{% endif %}
      <h2 class="bn-hiw__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% if block.settings.subheading != blank %}<p class="bn-hiw__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>{% endif %}
    </header>
    <div class="bn-hiw__steps-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign title_key = 'step_' | append: i | append: '_title'
          assign text_key = 'step_' | append: i | append: '_text'
        %}
        <article class="bn-hiw__step-{{ ai_gen_id }}">
          <div class="bn-hiw__icon-{{ ai_gen_id }}" aria-hidden="true">{{ 'circle' | placeholder_svg_tag }}</div>
          <div class="bn-hiw__step-copy-{{ ai_gen_id }}"><span class="bn-hiw__number-{{ ai_gen_id }}">0{{ i }}</span><h3 class="bn-hiw__step-title-{{ ai_gen_id }}">{{ block.settings[title_key] }}</h3><p class="bn-hiw__step-text-{{ ai_gen_id }}">{{ block.settings[text_key] }}</p></div>
        </article>
        {% unless i == 3 %}<div class="bn-hiw__divider-{{ ai_gen_id }}" aria-hidden="true"></div>{% endunless %}
      {% endfor %}
    </div>
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="bn-hiw__button-{{ ai_gen_id }}" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}
  </div>
</how-it-works-{{ ai_gen_id }}>

{% schema %}
