        align-items: center;
        justify-content: center;
        background: var(--bn-accent);
        color: #F7F4EE;
        font-weight: 600;
        font-size: 13px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        padding: 18px 44px;
        border-radius: 4px;
        text-decoration: none;
        transition: opacity 0.15s ease;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__button:hover { opacity: 0.85; }
     
      @media screen and (max-width: 749px) {
        .bn-how-it-works-{{ section.id }} { padding: 64px 28px 72px; }
        .bn-how-it-works-{{ section.id }} .bn-hiw__header { margin-bottom: 52px; }
