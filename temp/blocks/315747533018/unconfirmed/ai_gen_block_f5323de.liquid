        color: #5B5B54;
        margin: 0;
      }
     
      .bn-how-it-works-{{ section.id }} .bn-hiw__steps {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        width: 100%;
      }
     
      .bn-how-it-works-{{ section.id }} .bn-hiw__step {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        flex: 1;
        padding: 0 32px;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 28px;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__icon svg { display: block; }
      .bn-how-it-works-{{ section.id }} .bn-hiw__number {
        font-family: 'Cormorant Garamond', serif;
        font-size: 15px;
        font-weight: 600;
        color: var(--bn-accent);
        letter-spacing: 0.1em;
        margin-bottom: 10px;
        display: block;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__step-title {
        font-weight: 600;
        font-size: 18px;
        color: #1A1A1A;
        margin: 0 0 10px;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__step-text {
        font-weight: 400;
        font-size: 14.5px;
        line-height: 1.65;
        color: #6B6B63;
        margin: 0;
      }
      .bn-how-it-works-{{ section.id }} .bn-hiw__divider {
        width: 1px;
        align-self: stretch;
        background: #DEDACD;
        margin-top: 8px;
        flex: none;
      }
     
      .bn-how-it-works-{{ section.id }} .bn-hiw__button {
        margin-top: 72px;
