      .bn-how-it-works-{{ section.id }} .bn-hiw__inner {
        max-width: 1280px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
      }
     
      .bn-how-it-works-{{ section.id }} .bn-hiw__header {
        display: flex;
        flex-direction: column;
        align-items: center;
