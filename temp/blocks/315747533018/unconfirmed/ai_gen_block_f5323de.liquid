          align-items: flex-start;
          gap: 18px;
          width: 100%;
          padding: 26px 0;
        }
        .bn-how-it-works-{{ section.id }} .bn-hiw__icon { width: 40px; height: 40px; margin-bottom: 0; flex: none; }
        .bn-how-it-works-{{ section.id }} .bn-hiw__step-copy { display: flex; flex-direction: column; align-items: flex-start; }
