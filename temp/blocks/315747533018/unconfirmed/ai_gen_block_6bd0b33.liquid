{% doc %}
  @prompt
    Create a "How It Works" section for a premium fragrance subscription brand. It should have an eyebrow label, italic serif heading, subheading, and 3–4 step blocks displayed in a horizontal row with vertical dividers between them. Each step has an SVG icon (shopping bag, profile, rotate, sparkle), a two-digit number (01, 02, 03, 04) in accent color, a bold title, and a description. Include a centered CTA button below the steps. On mobile, steps stack vertically with horizontal dividers. Use Google Fonts: Cormorant Garamond (italic, 500) for headings and Work Sans for body. Background color #F7F4EE, accent color #2F4B3C. Section schema should have settings for eyebrow, heading, subheading, button label, button link, bg color, and accent color. Each step block has icon selector, title, and description. Preset includes 4 steps: Subscribe & Order, Log Into Your Account, Build Your Rotation, Keep the Compliments Coming.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% style %}@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,500&family=Work+Sans:wght@400;500;600;700&display=swap');.ai-how-{{ai_gen_id}}{display:block;width:100%;background:{{block.settings.bg_color}};color:{{block.settings.accent_color}};padding:80px 24px}.ai-how-{{ai_gen_id}}__inner{width:{{block.settings.desktop_width_percent}}%;max-width:1240px;margin:auto}.ai-how-{{ai_gen_id}}__header{text-align:center;max-width:720px;margin:0 auto 52px}.ai-how-{{ai_gen_id}}__eyebrow,.ai-how-{{ai_gen_id}}__number{font:600 11px/1.4 'Work Sans',sans-serif;letter-spacing:.18em;text-transform:uppercase}.ai-how-{{ai_gen_id}}__eyebrow{margin:0 0 14px}.ai-how-{{ai_gen_id}}__heading{margin:0;font:italic 500 clamp(42px,5vw,68px)/.95 'Cormorant Garamond',Georgia,serif}.ai-how-{{ai_gen_id}}__subheading{margin:18px auto 0;font:400 16px/1.6 'Work Sans',sans-serif}.ai-how-{{ai_gen_id}}__steps{display:grid;grid-template-columns:repeat(4,1fr)}.ai-how-{{ai_gen_id}}__step{text-align:center;padding:0 28px}.ai-how-{{ai_gen_id}}__step+.ai-how-{{ai_gen_id}}__step{border-left:1px solid currentColor}.ai-how-{{ai_gen_id}}__icon{height:38px;margin-bottom:16px}.ai-how-{{ai_gen_id}}__icon svg{width:30px;height:30px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round}.ai-how-{{ai_gen_id}}__number{display:block;margin-bottom:10px}.ai-how-{{ai_gen_id}}__title{margin:0 0 10px;font:700 17px/1.3 'Work Sans',sans-serif}.ai-how-{{ai_gen_id}}__description{margin:0;font:400 14px/1.6 'Work Sans',sans-serif}.ai-how-{{ai_gen_id}}__cta{display:block;width:max-content;margin:52px auto 0;padding:15px 28px;background:{{block.settings.accent_color}};color:{{block.settings.bg_color}};font:600 12px/1 'Work Sans',sans-serif;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}.ai-how-{{ai_gen_id}}__cta:focus-visible{outline:2px solid currentColor;outline-offset:4px}@media(max-width:749px){.ai-how-{{ai_gen_id}}{padding:60px 20px}.ai-how-{{ai_gen_id}}__inner{width:100%}.ai-how-{{ai_gen_id}}__steps{display:block}.ai-how-{{ai_gen_id}}__step{padding:28px 8px}.ai-how-{{ai_gen_id}}__step:first-child{padding-top:0}.ai-how-{{ai_gen_id}}__step+.ai-how-{{ai_gen_id}}__step{border-left:0;border-top:1px solid currentColor}}{% endstyle %}<how-it-works-{{ai_gen_id}} class="ai-how-{{ai_gen_id}}" {{block.shopify_attributes}}><div class="ai-how-{{ai_gen_id}}__inner"><header class="ai-how-{{ai_gen_id}}__header"><p class="ai-how-{{ai_gen_id}}__eyebrow">{{block.settings.eyebrow}}</p><h2 class="ai-how-{{ai_gen_id}}__heading">{{block.settings.heading}}</h2><div class="ai-how-{{ai_gen_id}}__subheading">{{block.settings.subheading}}</div></header><div class="ai-how-{{ai_gen_id}}__steps">{% for i in (1..4) %}{% assign icon_key='step_'|append:i|append:'_icon' %}{% assign title_key='step_'|append:i|append:'_title' %}{% assign desc_key='step_'|append:i|append:'_description' %}<article class="ai-how-{{ai_gen_id}}__step"><div class="ai-how-{{ai_gen_id}}__icon" aria-hidden="true">{% case block.settings[icon_key] %}{% when 'bag' %}<svg viewBox="0 0 24 24"><path d="M5 8h14l1 13H4L5 8Zm4 0V6a3 3 0 0 1 6 0v2"/></svg>{% when 'profile' %}<svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="3"/><path d="M5 20a7 7 0 0 1 14 0"/></svg>{% when 'rotate' %}<svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 0 0-14-4L4 9M4 4v5h5M4 13a8 8 0 0 0 14 4l2-2M20 20v-5h-5"/></svg>{% when 'sparkle' %}<svg viewBox="0 0 24 24"><path d="m12 3 2 5 5 2-5 2-2 5-2-5-5-2 5-2 2-5Zm7 13 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z"/></svg>{% endcase %}</div><span class="ai-how-{{ai_gen_id}}__number">0{{i}}</span><h3 class="ai-how-{{ai_gen_id}}__title">{{block.settings[title_key]}}</h3><p class="ai-how-{{ai_gen_id}}__description">{{block.settings[desc_key]}}</p></article>{% endfor %}</div>{% if block.settings.button_label != blank %}<a class="ai-how-{{ai_gen_id}}__cta" href="{{block.settings.button_link|default:'#'}}">{{block.settings.button_label}}</a>{% endif %}</div></how-it-works-{{ai_gen_id}}><script>(function(){if(!customElements.get('how-it-works-{{ai_gen_id}}'))customElements.define('how-it-works-{{ai_gen_id}}',class extends HTMLElement{connectedCallback(){this.setAttribute('role','region');this.setAttribute('aria-label','How it works')}})})();</script>{% schema %}{"name":"How it works","tag":null,"class":"how-it-works-block","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Base Note ritual"},{"type":"text","id":"heading","label":"Heading","default":"A better way to discover fragrance"},{"type":"textarea","id":"subheading","label":"Subheading","default":"Curated scents, delivered on your terms."},{"type":"text","id":"button_label","label":"Button label","default":"Start your rotation"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"bg_color","label":"Background","default":"#F7F4EE"},{"type":"color","id":"accent_color","label":"Accent","default":"#2F4B3C"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Step 1"},{"type":"select","id":"step_1_icon","label":"Icon","options":[{"value":"bag","label":"Shopping bag"},{"value":"profile","label":"Profile"},{"value":"rotate","label":"Rotate"},{"value":"sparkle","label":"Sparkle"}],"default":"bag"},{"type":"text","id":"step_1_title","label":"Title","default":"Subscribe & Order"},{"type":"textarea","id":"step_1_description","label":"Description","default":"Choose your plan and receive a new scent selected for you."},{"type":"header","content":"Step 2"},{"type":"select","id":"step_2_icon","label":"Icon","options":[{"value":"bag","label":"Shopping bag"},{"value":"profile","label":"Profile"},{"value":"rotate","label":"Rotate"},{"value":"sparkle","label":"Sparkle"}],"default":"profile"},{"type":"text","id":"step_2_title","label":"Title","default":"Log Into Your Account"},{"type":"textarea","id":"step_2_description","label":"Description","default":"Manage your preferences and delivery details with ease."},{"type":"header","content":"Step 3"},{"type":"select","id":"step_3_icon","label":"Icon","options":[{"value":"bag","label":"Shopping bag"},{"value":"profile","label":"Profile"},{"value":"rotate","label":"Rotate"},{"value":"sparkle","label":"Sparkle"}],"default":"rotate"},{"type":"text","id":"step_3_title","label":"Title","default":"Build Your Rotation"},{"type":"textarea","id":"step_3_description","label":"Description","default":"Discover new favorites around your taste."},{"type":"header","content":"Step 4"},{"type":"select","id":"step_4_icon","label":"Icon","options":[{"value":"bag","label":"Shopping bag"},{"value":"profile","label":"Profile"},{"value":"rotate","label":"Rotate"},{"value":"sparkle","label":"Sparkle"}],"default":"sparkle"},{"type":"text","id":"step_4_title","label":"Title","default":"Keep the Compliments Coming"},{"type":"textarea","id":"step_4_description","label":"Description","default":"Wear something exceptional every day."}],"presets":[{"name":"How it works"}]}{% endschema %}