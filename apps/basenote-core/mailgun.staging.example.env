# REFERENCE-ONLY TEST CONFIGURATION -- do not rename to .env, commit a filled
# copy, or use it for a production Worker. Runtime values belong in the
# separately approved staging secret manager only.
#
# The adapter refuses to start without every explicit staging gate below.
BASENOTE_RUNTIME_STAGE=staging
BASENOTE_MAILGUN_STAGING_ENABLED=true
BASENOTE_MAILGUN_TEST_ONLY=true
BASENOTE_STAGING_APP_ORIGIN=https://app-staging.basenotescent.com

# Mailgun's documented US endpoint. Use its EU endpoint only when the account
# itself is confirmed to be in that region.
BASENOTE_MAILGUN_API_BASE_URL=https://api.mailgun.net

# Start with the sandbox Mailgun assigns to the account. A dedicated sender is
# accepted only when its name begins mail-staging.; never put a production
# sender identity here.
BASENOTE_MAILGUN_TEST_DOMAIN=sandboxREPLACE_WITH_ACCOUNT_DOMAIN.mailgun.org
BASENOTE_MAILGUN_TEST_FROM=postmaster@sandboxREPLACE_WITH_ACCOUNT_DOMAIN.mailgun.org

# SIMULATE asks Mailgun to process but not deliver. ALLOWLISTED_DELIVERY is a
# separately reviewed test-inbox check and can target only the exact addresses
# or domains below.
BASENOTE_MAILGUN_TEST_DELIVERY_MODE=SIMULATE
BASENOTE_MAILGUN_TEST_RECIPIENTS=replace-with-one-verified-test-inbox@example.test
BASENOTE_MAILGUN_TEST_RECIPIENT_DOMAINS=

# Set this only as a runtime secret; do not place any value in this file,
# repository config, browser code, storefront Liquid, or a chat transcript.
# BASENOTE_MAILGUN_API_KEY=
