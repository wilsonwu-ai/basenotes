{%- layout 'theme' -%}
{% comment %} CART_ADDON_CONFIGURATION_GUARD: the internal $18 helper is never exposed as a standalone cart upsell. {% endcomment %}
{%- liquid
  assign has_subscription = false
  assign has_base_vial = false
  assign has_helper = false
  assign cart_configuration_issue = false
  assign rotation_variant = nil
  assign rotation_product = nil
  assign cart_savings = 0
  for item in cart.items
    assign item_title_down = item.variant.title | downcase
    assign compact_title = item_title_down | remove: ' '
    if item.product.handle == 'extra-5ml-vial-add-on'
      assign has_helper = true
      if item.properties['Selected scent'] == blank or item.selling_plan_allocation
        assign cart_configuration_issue = true
      endif
    elsif compact_title == '5ml' and item.variant.price == 2000
      assign has_base_vial = true
      if rotation_variant == blank and item.variant.selling_plan_allocations.size > 0
        assign rotation_variant = item.variant
        assign rotation_product = item.product
      endif
    endif
    if item.selling_plan_allocation
      assign has_subscription = true
    endif
    if item.variant.compare_at_price > item.final_price
      assign compare_line = item.variant.compare_at_price | times: item.quantity
      assign line_savings = compare_line | minus: item.final_line_price
      assign cart_savings = cart_savings | plus: line_savings
    endif
  endfor
-%}

<artifact-cart class="artifact-cart" data-has-subscription="{{ has_subscription }}">
  <div class="artifact-cart__shell">
    <a class="artifact-cart__back" href="/collections/fragrances">← Continue shopping</a>
    {%- if cart.item_count > 0 -%}
      <h1>Your Cart</h1>
      <p class="artifact-cart__status" data-cart-status role="status" aria-live="polite">{% if cart_configuration_issue %}An additional vial needs a valid one-time scent selection. Remove it and choose the fragrance again before checkout.{% elsif has_helper and has_base_vial == false %}An additional vial needs a first fragrance in the cart. Choose a fragrance below or remove the additional vial before continuing.{% endif %}</p>
      <form action="{{ routes.cart_url }}" method="post" class="artifact-cart__form">
        <div class="artifact-cart__layout">
          <div class="artifact-cart__main">
            <div class="artifact-cart__items">
              {%- for item in cart.items -%}
                {%- liquid
                  assign title_down = item.variant.title | downcase | remove: ' '
                  assign item_is_bottle = false
                  unless title_down == '5ml'
                    if title_down contains 'ml' or title_down contains 'oz' or title_down contains 'fullbottle'
                      assign item_is_bottle = true
                    endif
                  endunless
                  assign item_plan = item.variant.selling_plan_allocations.first.selling_plan
                  assign item_label = item.product.title
                  assign item_url = item.url
                  assign item_image = item.image
                  assign item_is_helper = false
                  assign source_product = nil
                  if item.product.handle == 'extra-5ml-vial-add-on'
                    assign item_is_helper = true
                    assign item_label = item.properties['Selected scent'] | default: 'Additional vial — choose a scent'
                    assign scent_handle = item.properties['_Base Note scent handle']
                    assign item_url = '/collections/fragrances'
                    assign item_image = nil
                    if scent_handle != blank
                      assign source_product = all_products[scent_handle]
                      assign item_url = source_product.url | default: item_url
                      assign item_image = source_product.featured_image
                    endif
                  endif
                -%}
                <article class="artifact-cart__item" data-cart-key="{{ item.key }}" data-plan-id="{{ item_plan.id }}" data-bottle="{{ item_is_bottle }}">
                  <a class="artifact-cart__image" href="{{ item_url }}" tabindex="-1" aria-hidden="true">
                    {%- if item_image -%}{{ item_image | image_url: width: 180 | image_tag: loading: 'lazy', width: 90, height: 110, alt: '' }}{%- else -%}{% render 'vial-illustration', product: source_product %}{%- endif -%}
                  </a>
                  <div class="artifact-cart__details">
                    <h2><a href="{{ item_url }}">{{ item_label | escape }}</a></h2>
                    <p>{%- if item_is_helper -%}5ml atomizer · additional vial{%- elsif item.variant.title != 'Default Title' -%}{{ item.variant.title | escape }}{% unless item_is_bottle %} atomizer{% endunless %}{%- endif -%}</p>
                    {%- if item.selling_plan_allocation -%}<p class="artifact-cart__plan">Monthly Rotation subscription</p>{%- elsif has_subscription and item_is_helper -%}<p class="artifact-cart__plan">One-time extra · does not renew</p>{%- endif -%}
                    <a class="artifact-cart__remove" href="{{ item.url_to_remove }}" data-cart-remove aria-label="Remove {{ item_label | escape }} from cart">Remove</a>
                  </div>
                  <div class="artifact-cart__quantity">
                    <button type="button" data-cart-step="-1" aria-label="Decrease {{ item_label | escape }} quantity" hidden>−</button>
                    <label class="visually-hidden" for="CartQuantity-{{ forloop.index }}">Quantity for {{ item_label | escape }}</label>
                    <input id="CartQuantity-{{ forloop.index }}" type="number" name="updates[]" min="0" max="99" value="{{ item.quantity }}" inputmode="numeric" data-cart-quantity>
                    <button type="button" data-cart-step="1" aria-label="Increase {{ item_label | escape }} quantity" hidden>+</button>
                  </div>
                  <strong class="artifact-cart__line-price" aria-label="Line total {{ item.final_line_price | money_without_trailing_zeros }}">{{ item.final_line_price | money_without_trailing_zeros }}</strong>
                </article>
              {%- endfor -%}
            </div>

            <noscript><button type="submit" name="update" class="artifact-cart__native-update" formnovalidate>Update quantities</button></noscript>
            {% if rotation_variant != blank or has_subscription %}<fieldset class="artifact-cart__order-mode">
              <legend>How would you like to order?</legend>
              <label class="artifact-cart__mode{% unless has_subscription %} artifact-cart__mode--active{% endunless %}">
                <input type="radio" name="artifact_order_mode" value="onetime" disabled {% unless has_subscription %}checked{% endunless %}>
                <span><strong>One-time purchase</strong><small>$20 for the first 5ml and $18 for each additional vial. No subscription, no renewals.</small></span>
              </label>
              <label class="artifact-cart__mode{% if has_subscription %} artifact-cart__mode--active{% endif %}">
                <input type="radio" name="artifact_order_mode" value="subscription" disabled {% if rotation_variant == blank %}data-unavailable="true"{% endif %} {% if has_subscription %}checked{% endif %}>
                <span><strong>Monthly Rotation <em>Subscription</em></strong><small>{% if rotation_variant != blank %}{{ rotation_variant.selling_plan_allocations.first.price | money_without_trailing_zeros }} for the first shipment, then {{ rotation_variant.selling_plan_allocations.first.price_adjustments.last.price | default: rotation_variant.price | money_without_trailing_zeros }} monthly for one 5ml vial of {{ rotation_product.title | escape }}.{% endif %} Extra vials and full bottles stay one-time purchases. Skip, swap, or cancel anytime.</small></span>
              </label>
              <a href="/pages/subscription-terms">What does the subscription actually include?</a>
              <noscript><p>To change your purchase option, visit the <a href="/pages/monthly-rotation">Monthly Rotation page</a>.</p></noscript>
            </fieldset>{% endif %}
          </div>

          <aside class="artifact-cart__summary" aria-labelledby="ArtifactSummaryTitle">
            <h2 id="ArtifactSummaryTitle">Order summary</h2>
            <dl class="artifact-cart__summary-lines">
              {%- for item in cart.items -%}<div><dt>{% if item.product.handle == 'extra-5ml-vial-add-on' %}{{ item.properties['Selected scent'] | default: 'Additional vial' | escape }}{% else %}{{ item.product.title | escape }}{% endif %}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</dt><dd>{{ item.final_line_price | money_without_trailing_zeros }}</dd></div>{%- endfor -%}
              <div><dt>Shipping &amp; taxes</dt><dd>Calculated at checkout</dd></div>
            </dl>
            <div class="artifact-cart__total"><span>Subtotal today</span><strong>{{ cart.total_price | money_without_trailing_zeros }}</strong></div>
            {%- if cart_savings > 0 -%}<div class="artifact-cart__savings"><span>You’re saving</span><strong>{{ cart_savings | money_without_trailing_zeros }}</strong></div>{%- endif -%}
            {%- if has_subscription -%}
              <div class="artifact-cart__disclosure"><strong>This is a recurring subscription.</strong>{% for item in cart.items %}{% if item.selling_plan_allocation %}<p>{{ item.product.title | escape }}: {{ item.selling_plan_allocation.price | times: item.quantity | money_without_trailing_zeros }} for this shipment, then {{ item.selling_plan_allocation.price_adjustments.last.price | default: item.variant.price | times: item.quantity | money_without_trailing_zeros }} every month until cancelled.</p>{% endif %}{% endfor %}<p>Skip, swap, or cancel in your account. Any one-time extras do not renew.</p></div>
              <label class="artifact-cart__consent"><input type="checkbox" required data-cart-consent> <span>I agree to the recurring subscription and <a href="/pages/subscription-terms">subscription terms</a>.</span></label>
            {%- else -%}
              <p class="artifact-cart__disclosure">One-time purchase. No subscription, no recurring charges.</p>
            {%- endif -%}
            <button class="artifact-cart__checkout" type="submit" name="checkout" data-cart-checkout {% if cart_configuration_issue or has_helper and has_base_vial == false %}disabled{% endif %}>Continue to payment</button>
            {% if has_helper and has_base_vial == false %}<a class="artifact-cart__back" href="/collections/fragrances">Choose a first fragrance</a>{% endif %}
          </aside>
        </div>
      </form>
    {%- else -%}
      <div class="artifact-cart__empty"><h1>Your Cart</h1><p>Your next scent is waiting.</p><a href="/collections/fragrances">Shop fragrances</a></div>
    {%- endif -%}
  </div>
</artifact-cart>

<style>
  .artifact-cart { --ac-green:#22392b; --ac-cream:#f4efe3; --ac-gold:#ac9159; --ac-ink:#242320; --ac-muted:#5c574d; --ac-line:rgb(34 57 43 / 18%); display:block; min-height:72dvh; color:var(--ac-ink); background:var(--ac-cream); }
  .artifact-cart__shell { width:min(100% - 3rem,68rem); margin-inline:auto; padding-block:2rem 5rem; }
  .artifact-cart__back { display:inline-block; padding-block-end:.18rem; border-block-end:.0625rem solid var(--ac-gold); color:var(--ac-green); font:.75rem/1.3 'Jost',sans-serif; }
  .artifact-cart h1 { margin:1.4rem 0 2rem; font:700 clamp(2.5rem,5vw,3.5rem)/1 'Playfair Display',serif; }
  .artifact-cart__layout { display:grid; grid-template-columns:minmax(0,1.4fr) minmax(19rem,.8fr); gap:3.5rem; align-items:start; }
  .artifact-cart__item { display:grid; grid-template-columns:5rem minmax(0,1fr) auto auto; gap:1.2rem; align-items:center; min-height:9rem; padding-block:1.2rem; border-block-end:.0625rem solid var(--ac-line); }
  .artifact-cart__image { display:grid; width:5rem; height:6.5rem; place-items:center; }
  .artifact-cart__image img,.artifact-cart__image svg { max-width:100%; max-height:100%; object-fit:contain; }
  .artifact-cart__details h2 { margin:0; font:500 1.2rem/1.2 'EB Garamond',serif; }
  .artifact-cart__details p { margin:.35rem 0 0; color:var(--ac-muted); font:.68rem/1.4 'Jost',sans-serif; letter-spacing:.08em; text-transform:uppercase; }
  .artifact-cart__details .artifact-cart__plan { color:var(--ac-gold); }
  .artifact-cart__remove { margin-block-start:.55rem; padding:0 0 .12rem; border:0; border-block-end:.0625rem solid var(--ac-muted); color:var(--ac-muted); background:transparent; font:.7rem/1.2 'Jost',sans-serif; cursor:pointer; }
  .artifact-cart__quantity { display:flex; align-items:center; border:.0625rem solid var(--ac-line); text-align:center; }
  .artifact-cart__quantity button,.artifact-cart__quantity input { display:grid; width:2.75rem; height:2.75rem; padding:0; place-items:center; border:0; color:var(--ac-ink); background:transparent; font:1rem/1 'Jost',sans-serif; text-align:center; }
  .artifact-cart__quantity input { appearance:textfield; }
  .artifact-cart__quantity input::-webkit-inner-spin-button { appearance:none; }
  .artifact-cart__quantity button { cursor:pointer; }
  .artifact-cart__line-price { min-width:4.8rem; text-align:end; font:500 .95rem/1 'Jost',sans-serif; }
  .artifact-cart__order-mode { margin-block-start:2rem; padding:1.6rem; border:.0625rem solid var(--ac-gold); }
  .artifact-cart__order-mode legend { padding:0 .25rem; font:600 .8rem/1.2 'Jost',sans-serif; letter-spacing:.06em; text-transform:uppercase; }
  .artifact-cart__mode { display:flex; gap:.9rem; padding:1rem; border:.0625rem solid var(--ac-line); cursor:pointer; }
  .artifact-cart__mode + .artifact-cart__mode { margin-block-start:.75rem; }
  .artifact-cart__mode--active { border-color:var(--ac-green); background:rgb(255 255 255 / 58%); }
  .artifact-cart__mode input { width:1rem; height:1rem; margin-block-start:.2rem; accent-color:var(--ac-green); }
  .artifact-cart__mode span,.artifact-cart__mode strong,.artifact-cart__mode small { display:block; }
  .artifact-cart__mode strong { font:600 .82rem/1.4 'Jost',sans-serif; }
  .artifact-cart__mode strong em { margin-inline-start:.45rem; padding:.22rem .4rem; color:var(--ac-green); background:var(--ac-gold); font:500 .58rem/1 'Jost',sans-serif; font-style:normal; }
  .artifact-cart__mode small { margin-block-start:.35rem; color:var(--ac-muted); font:.78rem/1.5 'Jost',sans-serif; }
  .artifact-cart__order-mode>a { display:inline-block; margin:1rem 0 0 2rem; padding-block-end:.15rem; border-block-end:.0625rem solid var(--ac-gold); color:var(--ac-green); font:.72rem/1.3 'Jost',sans-serif; }
  .artifact-cart__summary { position:sticky; inset-block-start:6rem; padding:1.7rem; border:.0625rem solid var(--ac-line); background:rgb(255 255 255 / 72%); }
  .artifact-cart__summary h2 { margin:0 0 1rem; padding-block-end:1rem; border-block-end:.0625rem solid var(--ac-line); font:600 .78rem/1.2 'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; }
  .artifact-cart__summary-lines { margin:0; }
  .artifact-cart__summary-lines div,.artifact-cart__total,.artifact-cart__savings { display:flex; justify-content:space-between; gap:1rem; padding-block:.55rem; font:.78rem/1.35 'Jost',sans-serif; }
  .artifact-cart__summary-lines dt { color:var(--ac-muted); }
  .artifact-cart__summary-lines dd { margin:0; text-align:end; }
  .artifact-cart__total { margin-block-start:.6rem; padding-block:1.15rem; border-block:.0625rem solid var(--ac-line); font-size:1rem; }
  .artifact-cart__savings { color:var(--ac-green); }
  .artifact-cart__disclosure { margin:1rem 0; color:var(--ac-muted); font:.72rem/1.5 'Jost',sans-serif; }
  .artifact-cart__consent { display:flex; gap:.6rem; margin-block:1rem; color:var(--ac-muted); font:.68rem/1.45 'Jost',sans-serif; }
  .artifact-cart__consent input { margin-block-start:.15rem; accent-color:var(--ac-green); }
  .artifact-cart__consent a { text-decoration:underline; }
  .artifact-cart__checkout { width:100%; min-height:3.6rem; border:.0625rem solid var(--ac-green); color:var(--ac-cream); background:var(--ac-green); font:500 .78rem/1 'Jost',sans-serif; letter-spacing:.1em; text-transform:uppercase; cursor:pointer; }
  .artifact-cart__checkout[disabled] { cursor:not-allowed; opacity:.48; }
  .artifact-cart__empty { padding-block:5rem 8rem; text-align:center; }
  .artifact-cart__empty a { display:inline-flex; min-height:3.4rem; align-items:center; padding-inline:1.4rem; color:var(--ac-cream); background:var(--ac-green); font:.75rem/1 'Jost',sans-serif; text-transform:uppercase; }
  .artifact-cart__status { margin:0; color:var(--ac-green); font:.85rem/1.5 'Jost',sans-serif; }
  .artifact-cart__status:not(:empty) { margin-block-end:1rem; padding:.75rem; border:.0625rem solid var(--ac-gold); }
  .artifact-cart__status a { text-decoration:underline; }
  .artifact-cart [hidden] { display:none; }
  .artifact-cart__remove { display:inline-flex; align-items:center; min-height:2.75rem; text-decoration:underline; border:0; }
  .artifact-cart__remove[aria-disabled="true"] { pointer-events:none; opacity:.45; }
  .artifact-cart__quantity :disabled { opacity:.45; cursor:wait; }
  .artifact-cart__disclosure,.artifact-cart__consent { font-size:.82rem; }
  .artifact-cart__consent input { min-width:1.2rem; min-height:1.2rem; }
  @media(max-width:52rem){.artifact-cart__layout{grid-template-columns:1fr}.artifact-cart__summary{position:static}.artifact-cart__item{grid-template-columns:4.5rem minmax(0,1fr) auto}.artifact-cart__line-price{grid-column:2;text-align:start}.artifact-cart__quantity{grid-column:3;grid-row:1 / span 2}}
  @media(max-width:35rem){.artifact-cart__shell{width:min(100% - 2rem,68rem)}.artifact-cart__item{grid-template-columns:3rem minmax(0,1fr);gap:.7rem}.artifact-cart__image{width:3rem}.artifact-cart__quantity{grid-column:2;grid-row:auto;width:max-content}.artifact-cart__line-price{grid-column:2}.artifact-cart__order-mode{padding:1rem}.artifact-cart__mode{padding:.85rem}}
  @media(prefers-reduced-motion:reduce){.artifact-cart__status{transition:none}}
</style>
